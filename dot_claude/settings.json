  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "agent-deck hook-handler",
            "type" : "command"
          }
        ],
        "matcher" : "permission_prompt|elicitation_dialog"
      },
      {
        "hooks" : [
          {
            "command" : "python3 '\/Users\/paper\/.claude\/hooks\/claude-island-state.py'",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "PermissionDenied" : [
