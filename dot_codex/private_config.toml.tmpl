model = "gpt-5.6-sol"
model_reasoning_effort = "medium"
# agent-deck notify hook. MUST be a top-level key: a `notify` nested under a
# table (it was previously under [notice]) is silently ignored by Codex.
notify = ["agent-deck", "codex-notify"]
[projects."/Users/paper"]
trust_level = "trusted"

[projects."/home/paper"]
trust_level = "trusted"

# --- Locally-earned directory trust ---
# Codex writes a [projects."<path>"] entry itself the first time it is trusted
# into a directory, so a plain `chezmoi apply` silently reverts them and an
# unattended Codex child then stalls on a trust prompt it cannot answer.
#
# Those paths name real checkouts, so they are NOT kept in this PUBLIC repo.
# They live instead in an unmanaged, machine-local file that this template
# splices in on every apply. Create it 0600 and never commit it:
#
#   ~/.codex/trust.local.toml
#   [projects."/abs/path/to/checkout"]
#   trust_level = "trusted"
#
# If the file is absent this renders to nothing, which is correct on a fresh box.
{{- $localTrust := joinPath .chezmoi.homeDir ".codex/trust.local.toml" }}
{{ if stat $localTrust }}{{ include $localTrust }}{{ end }}

[notice]
hide_gpt5_1_migration_prompt = true

[tui.model_availability_nux]
"gpt-5.5" = 1
