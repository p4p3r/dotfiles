#!/usr/bin/env python3
"""Read-only, secret-safe verifier for Agent Deck Codex and Claude hooks.

This checks static configuration and executable reachability only.  It never invokes
configured commands, Agent Deck, either agent runtime, tmux, or a remote service.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import sys
import tomllib
from typing import Any, Iterable


EXPECTED_CODEX_NOTIFY = ["agent-deck", "codex-notify"]
EXPECTED_CLAUDE_HOOKS = {
    "SessionStart": ("", True),
    "UserPromptSubmit": ("", True),
    "Stop": ("", False),
    "PermissionRequest": ("", False),
    "Notification": ("permission_prompt|elicitation_dialog", True),
    "SessionEnd": ("", True),
    "PreCompact": ("", False),
}
STATUS_VALUES = {"VERIFIED", "NOT_VERIFIED", "UNSUPPORTED", "SKIPPED"}
SAFE_CODE = re.compile(r"^[A-Z0-9_]+$")


class ConfigError(Exception):
    """Configuration cannot be parsed or safely resolved."""


@dataclass(frozen=True)
class Finding:
    runtime: str
    surface: str
    status: str
    reason: str
    path: str | None = None

    def render(self) -> str:
        if self.status not in STATUS_VALUES or not SAFE_CODE.fullmatch(self.reason):
            raise AssertionError("unsafe finding")
        fields = (
            f"runtime={self.runtime}",
            f"surface={self.surface}",
            f"status={self.status}",
            f"reason={self.reason}",
        )
        suffix = (f"path={self.path}",) if self.path else ()
        return " ".join((*fields, *suffix))


def reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ConfigError("duplicate JSON key")
        result[key] = value
    return result


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(
            path.read_text(encoding="utf-8"), object_pairs_hook=reject_duplicate_keys
        )
    except (OSError, UnicodeError, json.JSONDecodeError, ConfigError) as error:
        raise ConfigError("malformed JSON") from error
    if not isinstance(value, dict):
        raise ConfigError("JSON root is not an object")
    return value


def read_toml(path: Path) -> dict[str, Any]:
    try:
        value = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, tomllib.TOMLDecodeError) as error:
        raise ConfigError("malformed TOML") from error
    if not isinstance(value, dict):
        raise ConfigError("TOML root is not a table")
    return value


def label_path(path: Path, home: Path, cwd: Path) -> str:
    resolved = path.resolve(strict=False)
    roots = ((cwd.resolve(strict=False), "<cwd>"), (home.resolve(strict=False), "<home>"))
    for root, label in roots:
        try:
            relative = resolved.relative_to(root)
        except ValueError:
            continue
        return label if relative == Path(".") else f"{label}/{relative.as_posix()}"
    return f"<external>/{path.name}"


def executable_exists(command: str) -> bool:
    if "/" in command:
        path = Path(command)
        return path.is_file() and os.access(path, os.X_OK)
    return shutil.which(command) is not None


def expand_config_dir(raw: Any, home: Path) -> Path | None:
    if not isinstance(raw, str) or not raw.strip():
        return None
    value = raw.strip()
    value = value.replace("${HOME}", str(home)).replace("$HOME", str(home))
    if value == "~":
        value = str(home)
    elif value.startswith("~/"):
        value = str(home / value[2:])
    if "$" in value or not Path(value).is_absolute():
        raise ConfigError("config directory is not statically resolvable")
    return Path(value)


def nested_mapping(value: dict[str, Any], *keys: str) -> dict[str, Any]:
    current: Any = value
    for key in keys:
        if not isinstance(current, dict):
            return {}
        current = current.get(key, {})
    return current if isinstance(current, dict) else {}


def config_dir_from_agent_deck(
    config: dict[str, Any], runtime: str, profile: str, home: Path
) -> Path | None:
    profile_value = nested_mapping(config, "profiles", profile, runtime).get("config_dir")
    global_value = nested_mapping(config, runtime).get("config_dir")
    return expand_config_dir(profile_value or global_value, home)


def inline_codex_home(command: Any, home: Path) -> Path | None:
    if not isinstance(command, str) or not command.strip() or command.strip() == "codex":
        return None
    try:
        words = shlex.split(command)
    except ValueError as error:
        raise ConfigError("custom Codex command cannot be parsed") from error
    for word in words:
        if "=" not in word:
            break
        key, value = word.split("=", 1)
        if key == "CODEX_HOME":
            return expand_config_dir(value, home)
    raise ConfigError("custom Codex command hides its configuration root")


def ancestors_within(cwd: Path, home: Path) -> list[Path]:
    cwd = cwd.resolve(strict=False)
    home = home.resolve(strict=False)
    try:
        cwd.relative_to(home)
    except ValueError:
        return [cwd]
    result: list[Path] = []
    current = cwd
    while True:
        result.append(current)
        if current == home:
            break
        current = current.parent
    result.reverse()
    return result


def project_codex_configs(cwd: Path, home: Path) -> list[Path]:
    return [root / ".codex/config.toml" for root in ancestors_within(cwd, home) if root != home]


def has_nested_notify(config: dict[str, Any]) -> bool:
    return any(isinstance(value, dict) and "notify" in value for value in config.values())


def verify_codex(
    *,
    config_path: Path,
    cwd: Path,
    home: Path,
    optional: bool,
) -> tuple[Finding, list[Finding]]:
    details: list[Finding] = []
    runtime_present = executable_exists("codex")
    project_notify = False
    for project_path in project_codex_configs(cwd, home):
        if not project_path.exists():
            continue
        try:
            project_config = read_toml(project_path)
        except ConfigError:
            details.append(
                Finding(
                    "codex",
                    "project-notify",
                    "UNSUPPORTED",
                    "PROJECT_CONFIG_MALFORMED",
                    label_path(project_path, home, cwd),
                )
            )
            continue
        if "notify" in project_config or has_nested_notify(project_config):
            project_notify = True
            details.append(
                Finding(
                    "codex",
                    "project-notify",
                    "UNSUPPORTED",
                    "INEFFECTIVE_PROJECT_SCOPE",
                    label_path(project_path, home, cwd),
                )
            )

    if optional and not runtime_present and not config_path.exists():
        return Finding("codex", "config", "SKIPPED", "OPTIONAL_RUNTIME_ABSENT"), details
    if not runtime_present:
        return Finding("codex", "config", "NOT_VERIFIED", "RUNTIME_EXECUTABLE_MISSING"), details
    if not config_path.exists():
        reason = "MISSING_EFFECTIVE_NOTIFY" if project_notify else "CONFIG_MISSING"
        return Finding("codex", "config", "NOT_VERIFIED", reason), details
    try:
        config = read_toml(config_path)
    except ConfigError:
        return (
            Finding(
                "codex",
                "config",
                "NOT_VERIFIED",
                "MALFORMED_TOML",
                label_path(config_path, home, cwd),
            ),
            details,
        )
    notify = config.get("notify")
    if notify is None:
        reason = "MISPLACED_NOTIFY" if has_nested_notify(config) else "MISSING_EFFECTIVE_NOTIFY"
        return (
            Finding(
                "codex",
                "config",
                "NOT_VERIFIED",
                reason,
                label_path(config_path, home, cwd),
            ),
            details,
        )
    if notify != EXPECTED_CODEX_NOTIFY:
        return (
            Finding(
                "codex",
                "config",
                "NOT_VERIFIED",
                "WRONG_NOTIFY_COMMAND",
                label_path(config_path, home, cwd),
            ),
            details,
        )
    if not executable_exists(EXPECTED_CODEX_NOTIFY[0]):
        return (
            Finding(
                "codex",
                "config",
                "NOT_VERIFIED",
                "NOTIFY_EXECUTABLE_MISSING",
                label_path(config_path, home, cwd),
            ),
            details,
        )
    return (
        Finding(
            "codex",
            "config",
            "VERIFIED",
            "EXPECTED_NOTIFY",
            label_path(config_path, home, cwd),
        ),
        details,
    )


@dataclass(frozen=True)
class ClaudeLayer:
    name: str
    path: Path
    managed: bool = False


def claude_layers(
    config_dir: Path, cwd: Path, home: Path, managed: Iterable[Path]
) -> list[ClaudeLayer]:
    layers = [ClaudeLayer("USER", config_dir / "settings.json")]
    roots = [root for root in ancestors_within(cwd, home) if root != home]
    layers.extend(ClaudeLayer("PROJECT", root / ".claude/settings.json") for root in roots)
    layers.extend(ClaudeLayer("LOCAL", root / ".claude/settings.local.json") for root in roots)
    layers.extend(ClaudeLayer("MANAGED", path, managed=True) for path in managed)
    return layers


def highest_scalar(
    layers: list[tuple[ClaudeLayer, dict[str, Any]]], key: str
) -> tuple[Any, str] | None:
    # Layers arrive from lowest to highest precedence.  The last definition wins.
    selected: tuple[Any, str] | None = None
    for layer, config in layers:
        if key in config:
            selected = config[key], layer.name
    return selected


def validate_hook_event(groups: Any, matcher: str, asynchronous: bool) -> str | None:
    if not isinstance(groups, list):
        return "MALFORMED_EVENT"
    saw_expected_matcher = False
    saw_expected_command = False
    for group in groups:
        if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
            continue
        if group.get("matcher", "") != matcher:
            continue
        saw_expected_matcher = True
        for hook in group["hooks"]:
            if not isinstance(hook, dict):
                continue
            if hook.get("type") != "command" or hook.get("command") != "agent-deck hook-handler":
                continue
            saw_expected_command = True
            actual_async = hook.get("async", False)
            if not isinstance(actual_async, bool) or actual_async != asynchronous:
                continue
            return None
    if not saw_expected_matcher:
        return "WRONG_MATCHER"
    if not saw_expected_command:
        return "WRONG_COMMAND"
    return "WRONG_ASYNC"


def verify_claude(
    *,
    config_dir: Path,
    cwd: Path,
    home: Path,
    managed_paths: list[Path],
    optional: bool,
    agent_deck_hooks_enabled: bool,
) -> Finding:
    layers = claude_layers(config_dir, cwd, home, managed_paths)
    existing_layers = [layer for layer in layers if layer.path.exists()]
    runtime_present = executable_exists("claude")
    if optional and not runtime_present and not existing_layers:
        return Finding("claude", "config", "SKIPPED", "OPTIONAL_RUNTIME_ABSENT")
    if not runtime_present:
        return Finding("claude", "config", "NOT_VERIFIED", "RUNTIME_EXECUTABLE_MISSING")
    if not agent_deck_hooks_enabled:
        return Finding("claude", "config", "NOT_VERIFIED", "AGENT_DECK_HOOKS_DISABLED")
    parsed: list[tuple[ClaudeLayer, dict[str, Any]]] = []
    for layer in existing_layers:
        try:
            parsed.append((layer, read_json(layer.path)))
        except ConfigError:
            return Finding(
                "claude",
                "config",
                "NOT_VERIFIED",
                "MALFORMED_JSON",
                label_path(layer.path, home, cwd),
            )
    if not parsed:
        return Finding("claude", "config", "NOT_VERIFIED", "CONFIG_MISSING")

    disabled = highest_scalar(parsed, "disableAllHooks")
    if disabled is not None:
        value, source = disabled
        if not isinstance(value, bool):
            return Finding("claude", "config", "NOT_VERIFIED", "MALFORMED_DISABLE_ALL_HOOKS")
        if value:
            return Finding("claude", "config", "NOT_VERIFIED", f"HOOKS_DISABLED_BY_{source}")

    managed_only = highest_scalar(parsed, "allowManagedHooksOnly")
    if managed_only is not None:
        value, source = managed_only
        if source != "MANAGED" or not isinstance(value, bool):
            return Finding("claude", "config", "UNSUPPORTED", "INVALID_MANAGED_POLICY")
        if value:
            parsed = [(layer, config) for layer, config in parsed if layer.managed]

    hooks_by_event: dict[str, list[Any]] = {}
    for _layer, config in parsed:
        hooks = config.get("hooks")
        if hooks is None:
            continue
        if not isinstance(hooks, dict):
            return Finding("claude", "config", "NOT_VERIFIED", "MALFORMED_HOOKS")
        for event, groups in hooks.items():
            if isinstance(groups, list):
                hooks_by_event.setdefault(event, []).extend(groups)
            else:
                hooks_by_event.setdefault(event, []).append({"invalid": True})

    if managed_only is not None and managed_only[0] is True and not hooks_by_event:
        return Finding("claude", "config", "NOT_VERIFIED", "MANAGED_HOOKS_ONLY")

    for event, (matcher, asynchronous) in EXPECTED_CLAUDE_HOOKS.items():
        if event not in hooks_by_event:
            return Finding("claude", "config", "NOT_VERIFIED", f"MISSING_EVENT_{event.upper()}")
        drift = validate_hook_event(hooks_by_event[event], matcher, asynchronous)
        if drift:
            return Finding("claude", "config", "NOT_VERIFIED", f"{drift}_{event.upper()}")
    if not executable_exists("agent-deck"):
        return Finding("claude", "config", "NOT_VERIFIED", "HOOK_EXECUTABLE_MISSING")
    return Finding(
        "claude",
        "config",
        "VERIFIED",
        "EXPECTED_HOOKS",
        label_path(config_dir / "settings.json", home, cwd),
    )


def default_agent_deck_config(home: Path) -> Path:
    xdg_raw = os.environ.get("XDG_CONFIG_HOME")
    xdg = Path(xdg_raw) if xdg_raw else home / ".config"
    current = xdg / "agent-deck/config.toml"
    legacy = home / ".agent-deck/config.toml"
    return current if current.exists() or not legacy.exists() else legacy


def default_managed_settings() -> list[Path]:
    candidates = [Path("/etc/claude-code/managed-settings.json")]
    return [path for path in candidates if path.exists()]


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Verify static Agent Deck hook/notify wiring without invoking any hook.",
        epilog=(
            "Both runtimes are required by default. --optional-runtime may skip a runtime only "
            "when both its executable and configuration are absent."
        ),
    )
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument("--cwd", type=Path, default=Path.cwd())
    parser.add_argument("--profile", default=os.environ.get("AGENTDECK_PROFILE", "default"))
    parser.add_argument("--agent-deck-config", type=Path)
    parser.add_argument("--codex-home", type=Path)
    parser.add_argument("--claude-config-dir", type=Path)
    parser.add_argument("--claude-managed-settings", action="append", default=[], type=Path)
    parser.add_argument(
        "--fixture",
        action="store_true",
        help="use only explicit/test-root config and ignore live environment and managed defaults",
    )
    parser.add_argument(
        "--optional-runtime",
        action="append",
        choices=("codex", "claude"),
        default=[],
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    home = args.home.resolve(strict=False)
    cwd = args.cwd.resolve(strict=False)
    agent_deck_path = args.agent_deck_config or default_agent_deck_config(home)
    try:
        agent_deck_config = read_toml(agent_deck_path) if agent_deck_path.exists() else {}
    except ConfigError:
        for runtime in ("codex", "claude"):
            finding = Finding(runtime, "config", "NOT_VERIFIED", "AGENT_DECK_CONFIG_MALFORMED")
            print(finding.render())
        return 1

    optional = set(args.optional_runtime)
    try:
        codex_home = args.codex_home
        if codex_home is None:
            env_home = None if args.fixture else os.environ.get("CODEX_HOME")
            if env_home:
                codex_home = expand_config_dir(env_home, home)
            else:
                command = nested_mapping(agent_deck_config, "codex").get("command")
                codex_home = inline_codex_home(command, home)
                if codex_home is None:
                    codex_home = config_dir_from_agent_deck(
                        agent_deck_config, "codex", args.profile, home
                    )
        codex_home = (codex_home or home / ".codex").resolve(strict=False)

        claude_config_dir = args.claude_config_dir
        if claude_config_dir is None:
            env_dir = None if args.fixture else os.environ.get("CLAUDE_CONFIG_DIR")
            if env_dir:
                claude_config_dir = expand_config_dir(env_dir, home)
            else:
                claude_command = nested_mapping(agent_deck_config, "claude").get("command")
                if isinstance(claude_command, str) and claude_command.strip() not in ("", "claude"):
                    raise ConfigError("custom Claude command hides configuration root")
                claude_config_dir = config_dir_from_agent_deck(
                    agent_deck_config, "claude", args.profile, home
                )
        claude_config_dir = (claude_config_dir or home / ".claude").resolve(strict=False)
    except ConfigError:
        for runtime in ("codex", "claude"):
            print(Finding(runtime, "config", "UNSUPPORTED", "CONFIG_ROOT_UNRESOLVED").render())
        return 1

    managed_default = [] if args.fixture else default_managed_settings()
    managed_paths = args.claude_managed_settings or managed_default
    hooks_enabled = nested_mapping(agent_deck_config, "claude").get("hooks_enabled", True)
    if not isinstance(hooks_enabled, bool):
        hooks_enabled = False

    codex, codex_details = verify_codex(
        config_path=codex_home / "config.toml",
        cwd=cwd,
        home=home,
        optional="codex" in optional,
    )
    claude = verify_claude(
        config_dir=claude_config_dir,
        cwd=cwd,
        home=home,
        managed_paths=managed_paths,
        optional="claude" in optional,
        agent_deck_hooks_enabled=hooks_enabled,
    )
    for finding in (codex, *codex_details, claude):
        print(finding.render())
    for runtime, surface in (
        ("codex", "hook-invocation"),
        ("claude", "hook-invocation"),
        ("agent-deck", "inbox-delivery"),
        ("agent-deck", "child-completion"),
        ("slack", "end-to-end-delivery"),
    ):
        print(Finding(runtime, surface, "NOT_VERIFIED", "OUT_OF_SCOPE").render())

    accepted = {"VERIFIED", "SKIPPED"}
    return 0 if codex.status in accepted and claude.status in accepted else 1


if __name__ == "__main__":
    raise SystemExit(main())
