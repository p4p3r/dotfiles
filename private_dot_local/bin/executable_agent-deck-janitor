#!/usr/bin/env python3
"""Deterministic Agent Deck and workspace janitor.

The maintenance controller and fleet custodian in this repository are
report-only by charter: they observe and never act. This is the acting half,
and it is deliberately not an agent turn. Every rule here is mechanical, every
destructive step is bounded by an explicit configured root, and nothing runs
without --apply.

Tasks are independent. One failing task degrades its own result and never
suppresses or aborts another, because a janitor that stops at the first error
silently stops maintaining everything behind it.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time

VERSION = 1
NAME = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")
GROUP_PATH = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\Z")
# tmux socket names are chosen by whatever started the server, so they are
# longer and freer than a row name, but still one bounded path segment.
SOCKET_NAME = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\Z")
# `session cleanup --dry-run` lists what is dead now; a row can be alive again
# by the time the removal runs, and the CLI then refuses it. Only stopped and
# errored rows may be removed without --force, which this tool never passes.
LIVE_AGAIN = re.compile(r"only stopped/error sessions may be removed")
# A depth heuristic was the first attempt and it was wrong in both directions:
# it refused /tmp, which is the single largest thing worth sweeping, while
# happily accepting /home/someone. An explicit denylist says what is actually
# unsafe. The home directory is added at runtime.
FORBIDDEN_ROOTS = frozenset({
    "/", "/bin", "/boot", "/dev", "/etc", "/home", "/lib", "/nix", "/opt",
    "/proc", "/root", "/run", "/sbin", "/srv", "/sys", "/usr", "/var",
})
# A real /tmp carries thousands of entries. The first cap was 4096, which a
# live box exceeded immediately: the sweep stopped at an alphabetical prefix
# and the rest of the root was never reached on any run, however often it ran.
MAX_ENTRIES_PER_ROOT = 65536
# A process tree deep enough to need more hops than this is a cycle or a fork
# bomb, not an agent in a tmux pane.
MAX_PROCESS_DEPTH = 32
DEFAULT_COMMAND_TIMEOUT = 300


class Rejected(Exception):
    """An input that cannot be made safe, so it is never partially applied."""


def utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def parse_timestamp(value):
    """Epoch seconds for an RFC 3339 stamp, or None when it cannot be read.

    An unreadable age must never be treated as an old one: every rule here
    acts on things that are too old, so the failure has to fall the safe way.
    """
    if not isinstance(value, str) or not value:
        return None
    text = value.strip().replace("Z", "+00:00")
    try:
        from datetime import datetime

        return datetime.fromisoformat(text).timestamp()
    except ValueError:
        return None


def run(argv, timeout=DEFAULT_COMMAND_TIMEOUT, cwd=None):
    """Run one argv with no shell. Returns (ok, stdout, summary)."""
    try:
        done = subprocess.run(argv, capture_output=True, text=True,
                              timeout=timeout, check=False, cwd=cwd)
    except FileNotFoundError:
        return False, "", "executable not found"
    except subprocess.TimeoutExpired:
        return False, "", f"timed out after {timeout}s"
    except OSError as exc:
        return False, "", f"{exc.__class__.__name__}"
    if done.returncode != 0:
        tail = (done.stderr or done.stdout or "").strip().splitlines()
        return False, done.stdout, f"exit {done.returncode}: {tail[-1] if tail else 'no output'}"
    return True, done.stdout, "ok"


def real(path: str) -> str:
    """Resolve symlinks before comparing paths.

    git reports a worktree by its resolved path while a session or a
    configuration may name it through a symlink -- a symlinked home or, on
    macOS, /var versus /private/var. Comparing the two unresolved made an
    occupied worktree look free.
    """
    return os.path.realpath(path)


def load_json(text):
    try:
        return json.loads(text)
    except ValueError:
        return None


def check_root(path: str) -> str:
    """An absolute, normalized directory that is not a system or home root."""
    if not path.startswith("/"):
        raise Rejected(f"root {path!r} must be absolute")
    normalized = os.path.normpath(path)
    if normalized != path.rstrip("/") and normalized != path:
        raise Rejected(f"root {path!r} must already be normalized")
    if normalized in FORBIDDEN_ROOTS:
        raise Rejected(f"root {path!r} is never safe to sweep")
    if normalized == os.path.expanduser("~").rstrip("/"):
        raise Rejected("the home directory is never swept")
    return normalized


def parse_artifact_rule(value: str) -> tuple[str, int]:
    """ROOT:DAYS, where ROOT is absolute and DAYS is a positive integer."""
    path, _, days = value.rpartition(":")
    if not path or not days:
        raise Rejected(f"artifact rule {value!r} must be ROOT:DAYS")
    if not days.isdigit() or int(days) < 1:
        raise Rejected(f"artifact rule {value!r} needs a positive day count")
    if not path.startswith("/"):
        raise Rejected(f"artifact root {path!r} must be absolute")
    normalized = os.path.normpath(path)
    if normalized != path.rstrip("/") and normalized != path:
        raise Rejected(f"artifact root {path!r} must already be normalized")
    if normalized in FORBIDDEN_ROOTS:
        raise Rejected(f"artifact root {path!r} is never safe to sweep")
    if normalized == os.path.expanduser("~").rstrip("/"):
        raise Rejected("the home directory is never swept as an artifact root")
    return normalized, int(days)


def parse_expiring_rule(value: str) -> tuple[str, int]:
    """PATH:DAYS for a path that is itself removed once it is old enough.

    Sweeping the children of a root is wrong for a single large build
    directory: the directory itself is the thing to remove, and naming it
    explicitly means no pattern can ever expand to something unintended.
    """
    path, days = parse_artifact_rule(value)
    return path, days


class Janitor:
    def __init__(self, args):
        self.args = args
        self.apply = args.apply
        self.results = {}

    def record(self, task, status, **fields):
        entry = {"status": status, "observed": utc()}
        entry.update(fields)
        self.results[task] = entry

    # -- profiles -----------------------------------------------------------

    def profiles(self):
        """Configured profiles, or every valid local one when none are given."""
        if self.args.profile:
            return list(self.args.profile)
        root = os.path.expanduser("~/.local/share/agent-deck/profiles")
        try:
            names = sorted(os.listdir(root))
        except OSError:
            return ["default"]
        found = []
        for name in names:
            if not NAME.match(name):
                continue
            path = os.path.join(root, name)
            if os.path.islink(path) or not os.path.isdir(path):
                continue
            found.append(name)
        return found or ["default"]

    # -- sessions -----------------------------------------------------------

    def cleanup_candidates(self, profile, days, include_archived):
        """One `session cleanup --dry-run` listing, or None when it fails.

        The CLI decides what is dead and idle; this only reads its answer.
        """
        argv = [self.args.agent_deck, "-p", profile, "session", "cleanup",
                "--days", str(days), "--dry-run", "--json"]
        if include_archived:
            argv.append("--include-archived")
        ok, out, summary = run(argv)
        if not ok:
            return None, summary
        payload = load_json(out)
        if not isinstance(payload, dict):
            return None, "cleanup did not return an object"
        # With nothing to purge the CLI answers in a different shape --
        # {"count": 0, "removed": [], "skipped": 0, "success": true} and no
        # candidates key at all -- so an absent list means an empty one,
        # not a malformed reply.
        candidates = payload.get("candidates")
        if candidates is None and (payload.get("success") or payload.get("count") == 0):
            candidates = []
        if not isinstance(candidates, list):
            return None, "candidate list was not a list"
        return candidates, "ok"

    def retention_for(self, row):
        """Days a row must have been idle before it may be purged.

        A stopped row is one an agent finished with: the conductor fleet
        creates these by the dozen for a single piece of work and they are
        never returned to, so they age out faster than a row that merely went
        quiet. An archived row is already invisible, which is why nothing ever
        reclaimed one; it gets the longest window rather than none at all.
        """
        if row.get("archived"):
            return self.args.archived_retention_days
        if row.get("status") == "stopped" and self.args.stopped_retention_days:
            return self.args.stopped_retention_days
        return self.args.session_retention_days

    def sweep_sessions(self):
        """Delegate to `session cleanup`, which already encodes the hard rules.

        It purges only sessions with no live tmux pane that have also been
        inactive for the retention window, retains pinned, and keeps worktrees
        and transcripts. --prune-worktree is deliberately never passed:
        uncommitted work is not this tool's to destroy.

        Windows differ by what a row is, so the CLI is asked for the widest
        candidate set -- the shortest window, archived included -- and each row
        is then held to its own. Asking per window instead would race: a row
        can change status between two listings.
        """
        detail = {}
        worst = "OK"
        windows = [self.args.session_retention_days]
        if self.args.stopped_retention_days:
            windows.append(self.args.stopped_retention_days)
        if self.args.archived_retention_days:
            windows.append(self.args.archived_retention_days)
        widest = min(windows)
        for profile in self.profiles():
            # Its own --force is the single flag for "ignore pins", and pins
            # have no CLI setter, so protection by title is done here by taking
            # its candidate list and removing the exempt rows one by one.
            candidates, summary = self.cleanup_candidates(
                profile, widest, bool(self.args.archived_retention_days))
            if candidates is None:
                detail[profile] = {"ok": False, "summary": summary}
                worst = "DEGRADED"
                continue

            purge, exempt, young = [], [], 0
            for row in candidates:
                if not isinstance(row, dict) or not isinstance(row.get("id"), str):
                    continue
                if row.get("title") in self.args.protect_session_title:
                    exempt.append({"id": row["id"], "title": row.get("title")})
                    continue
                window = self.retention_for(row)
                if not window:
                    # Archived rows are listed only when a window exists for
                    # them, so this is the "never purge archived" setting.
                    continue
                idle = row.get("idle_days")
                if isinstance(idle, (int, float)) and idle < window:
                    young += 1
                    continue
                purge.append(row)

            removed, failed, revived = [], [], []
            for row in purge:
                if not self.apply:
                    removed.append({"id": row["id"], "title": row.get("title"),
                                    "idle_days": row.get("idle_days")})
                    continue
                ok, _, summary = run([self.args.agent_deck, "-p", profile,
                                      "session", "remove", row["id"]])
                if ok:
                    removed.append({"id": row["id"], "title": row.get("title"),
                                    "idle_days": row.get("idle_days")})
                elif LIVE_AGAIN.search(summary):
                    # The row woke up between the listing and the removal, and
                    # the CLI refused it for exactly the right reason. That is
                    # the safety rail working, not a fault to report.
                    revived.append({"id": row["id"], "title": row.get("title")})
                else:
                    failed.append({"id": row["id"], "summary": summary})
                    worst = "DEGRADED"
            detail[profile] = {"ok": True, "removed": removed, "exempt": exempt,
                               "revived": revived, "failed": failed, "young": young}
        self.record("sessions", worst, retention_days=self.args.session_retention_days,
                    stopped_retention_days=self.args.stopped_retention_days,
                    archived_retention_days=self.args.archived_retention_days,
                    applied=self.apply, profiles=detail)

    def stop_idle_sessions(self):
        """Stop rows whose agent has been parked at a prompt for too long.

        `session cleanup` purges only rows with no live pane, and a waiting row
        has one: an agent sitting at a prompt never dies, so no retention window
        can ever reach it. Box 2 carried 62 such rows aged 7 to 34 days, each
        holding a live process. Stopping them makes them ordinary dead rows,
        which the stopped window then reclaims a few days later -- nothing is
        both stopped and removed on the same run.

        Stopping destroys in-memory context and anything unsent in the
        composer, which is why this window is the longest one here and why a
        row someone is watching, or one still running, is never touched.
        """
        if not self.args.stop_idle_days:
            self.record("idle_sessions", "SKIPPED")
            return
        cutoff = self.now() - self.args.stop_idle_days * 86400
        detail = {}
        worst = "OK"
        for profile in self.profiles():
            ok, out, summary = run([self.args.agent_deck, "-p", profile, "list", "--json"],
                                   timeout=120)
            rows = load_json(out) if ok else None
            if not ok or not isinstance(rows, list):
                detail[profile] = {"ok": False, "summary": summary if not ok else "list did not return an array"}
                worst = "DEGRADED"
                continue
            stopped, failed = [], []
            kept = {"running": 0, "watched": 0, "protected": 0, "young": 0, "other": 0}
            for row in rows:
                if not isinstance(row, dict) or not isinstance(row.get("id"), str):
                    continue
                status = row.get("status")
                if status not in ("waiting", "idle"):
                    # A running row is doing work; a stopped or errored one is
                    # already the cleanup task's business.
                    kept["running" if status == "running" else "other"] += 1
                    continue
                if row.get("title") in self.args.protect_session_title:
                    kept["protected"] += 1
                    continue
                # Someone is looking at this pane right now.
                if row.get("viewers"):
                    kept["watched"] += 1
                    continue
                seen = parse_timestamp(row.get("last_activity_at"))
                if seen is None or seen >= cutoff:
                    # An unknown age is not an old one.
                    kept["young"] += 1
                    continue
                entry = {"id": row["id"], "title": row.get("title"),
                         "group": row.get("group"),
                         "idle_days": int((self.now() - seen) // 86400)}
                if not self.apply:
                    stopped.append(entry)
                    continue
                ok, _, summary = run([self.args.agent_deck, "-p", profile,
                                      "session", "stop", row["id"]])
                if ok:
                    stopped.append(entry)
                else:
                    failed.append({"id": row["id"], "summary": summary})
                    worst = "DEGRADED"
            detail[profile] = {"ok": True, "stopped": stopped, "failed": failed, "kept": kept}
        self.record("idle_sessions", worst, applied=self.apply,
                    stop_idle_days=self.args.stop_idle_days, profiles=detail)

    # -- groups -------------------------------------------------------------

    def sweep_groups(self):
        """Delete only groups that hold no sessions and nothing beneath them.

        A group whose path is a prefix of another group's path is a parent, and
        deleting it would reparent or strand its children, so it is retained
        however empty it looks.
        """
        if not self.args.empty_groups:
            self.record("groups", "SKIPPED")
            return
        detail = {}
        worst = "OK"
        for profile in self.profiles():
            ok, out, summary = run([self.args.agent_deck, "-p", profile,
                                    "group", "list", "--json"])
            if not ok:
                detail[profile] = {"ok": False, "summary": summary}
                worst = "DEGRADED"
                continue
            payload = load_json(out)
            groups = payload.get("groups") if isinstance(payload, dict) else payload
            if not isinstance(groups, list):
                detail[profile] = {"ok": False, "summary": "group list was not a list"}
                worst = "DEGRADED"
                continue

            paths = [g.get("path") for g in groups if isinstance(g, dict)]
            removed, kept, failed = [], [], []
            for group in groups:
                if not isinstance(group, dict):
                    continue
                name, path = group.get("name"), group.get("path")
                count = group.get("session_count")
                if not isinstance(name, str) or not isinstance(path, str):
                    continue
                if not GROUP_PATH.match(path) or not NAME.match(name):
                    kept.append({"path": path, "reason": "unsafe name"})
                    continue
                if count != 0:
                    continue
                if name in self.args.protect_group or path in self.args.protect_group:
                    kept.append({"path": path, "reason": "protected"})
                    continue
                if any(other != path and other.startswith(path + "/") for other in paths
                       if isinstance(other, str)):
                    kept.append({"path": path, "reason": "has descendants"})
                    continue
                if not self.apply:
                    removed.append(path)
                    continue
                ok, _, summary = run([self.args.agent_deck, "-p", profile,
                                      "group", "delete", path])
                if ok:
                    removed.append(path)
                else:
                    failed.append({"path": path, "summary": summary})
                    worst = "DEGRADED"
            detail[profile] = {"ok": True, "removed": removed, "kept": kept,
                               "failed": failed}
        self.record("groups", worst, applied=self.apply, profiles=detail)

    # -- worktrees ----------------------------------------------------------

    def prune_worktrees(self):
        """`git worktree prune` only.

        This removes administrative entries whose working directory is already
        gone. It cannot delete a worktree that still exists, so it can never
        destroy work. Removing live worktrees would need clean/pushed/protected
        checks and stays out of scope.
        """
        if not self.args.repo:
            self.record("worktrees", "SKIPPED")
            return
        detail = {}
        worst = "OK"
        for repo in self.args.repo:
            if not os.path.isdir(os.path.join(repo, ".git")) and not os.path.isdir(repo):
                detail[repo] = {"ok": False, "summary": "not a directory"}
                worst = "DEGRADED"
                continue
            argv = [self.args.git, "-C", repo, "worktree", "prune", "-v"]
            if not self.apply:
                argv.append("--dry-run")
            ok, out, summary = run(argv)
            detail[repo] = {"ok": ok, "summary": summary,
                            "pruned": [l for l in out.strip().splitlines() if l][:64]}
            if not ok:
                worst = "DEGRADED"
        self.record("worktrees", worst, applied=self.apply, repositories=detail)

    # -- nix store ----------------------------------------------------------

    def collect_nix_garbage(self):
        if self.args.nix_generations_days is None:
            self.record("nix", "SKIPPED")
            return
        nix_collect = shutil.which("nix-collect-garbage")
        if not nix_collect:
            self.record("nix", "SKIPPED", reason="nix-collect-garbage not on PATH")
            return
        argv = [nix_collect, "--delete-older-than", f"{self.args.nix_generations_days}d"]
        if not self.apply:
            argv.append("--dry-run")
        ok, out, summary = run(argv, timeout=self.args.nix_timeout)
        self.record("nix", "OK" if ok else "DEGRADED", applied=self.apply,
                    summary=summary, output=out.strip()[-2000:])

    # -- build artifacts ----------------------------------------------------

    def sweep_artifacts(self):
        """Delete entries directly under each configured root, by age.

        Only the immediate children of a root are considered, so one stale rule
        cannot walk a whole filesystem. Symlinks are removed as links and never
        followed, which keeps a symlink inside a scratch root from reaching
        anything outside it.
        """
        if not self.args.artifact:
            self.record("artifacts", "SKIPPED")
            return
        now = time.time()
        detail = {}
        worst = "OK"
        for rule in self.args.artifact:
            root, days = rule
            cutoff = now - days * 86400
            entry = {"older_than_days": days, "removed": [], "failed": [],
                     "foreign": 0, "bytes": 0, "truncated": False}
            if os.path.islink(root) or not os.path.isdir(root):
                entry["skipped"] = "root is missing or not a directory"
                detail[root] = entry
                continue
            try:
                names = sorted(os.listdir(root))
            except OSError as exc:
                entry["skipped"] = exc.__class__.__name__
                worst = "DEGRADED"
                detail[root] = entry
                continue
            if len(names) > MAX_ENTRIES_PER_ROOT:
                names = names[:MAX_ENTRIES_PER_ROOT]
                entry["truncated"] = True
            for name in names:
                path = os.path.join(root, name)
                if self.effective_mtime(path) >= cutoff:
                    continue
                if self.args.keep_pattern and any(
                        re.search(p, name) for p in self.args.keep_pattern):
                    continue
                # A shared scratch root holds other people's files. Those are
                # not ours to delete, and failing to delete one is the correct
                # outcome rather than a fault to report.
                try:
                    if os.lstat(path).st_uid != os.getuid():
                        entry["foreign"] = entry.get("foreign", 0) + 1
                        continue
                except OSError:
                    continue
                entry["bytes"] += self.size_of(path)
                if not self.apply:
                    entry["removed"].append(path)
                    continue
                try:
                    self.remove_entry(path)
                    entry["removed"].append(path)
                except PermissionError as exc:
                    # A scratch tree can hold files written by another uid --
                    # a container, a bazel sandbox. The chmod retry refuses to
                    # touch those by design, so rmtree cannot finish. That is
                    # the rule working, not a fault: count it where the other
                    # foreign entries are counted and leave the tree alone.
                    if self.holds_foreign_entries(path):
                        entry["foreign"] = entry.get("foreign", 0) + 1
                        continue
                    entry["failed"].append({"path": path,
                                            "error": exc.__class__.__name__})
                    worst = "DEGRADED"
                except OSError as exc:
                    entry["failed"].append({"path": path,
                                            "error": exc.__class__.__name__})
                    worst = "DEGRADED"
            detail[root] = entry
        self.record("artifacts", worst, applied=self.apply, roots=detail)

    @staticmethod
    def holds_foreign_entries(path) -> bool:
        """True when any entry under path belongs to another user.

        Only asked after a deletion was refused, so the walk costs nothing on
        the ordinary path. A tree someone else wrote into is not ours to
        remove, however old it is.
        """
        uid = os.getuid()
        for current, dirs, files in os.walk(path, topdown=True, followlinks=False):
            for name in [current] + [os.path.join(current, n) for n in dirs + files]:
                try:
                    if os.lstat(name).st_uid != uid:
                        return True
                except OSError:
                    continue
        return False

    @staticmethod
    def remove_entry(path) -> None:
        """Delete one entry, restoring write permission on our own trees.

        Test fixtures and extracted archives leave directories without the
        write bit, and rmtree then fails on contents the owner can perfectly
        well delete: 27 of them survived box 2's first armed run. The retry
        changes modes only under a path already chosen for deletion, and only
        where we are the owner, so nothing outside that tree is touched.
        """
        if os.path.islink(path) or not os.path.isdir(path):
            os.unlink(path)
            return
        try:
            shutil.rmtree(path)
            return
        except PermissionError:
            pass
        uid = os.getuid()
        for current, dirs, _ in os.walk(path, topdown=True, followlinks=False):
            for name in [current] + [os.path.join(current, d) for d in dirs]:
                try:
                    if os.lstat(name).st_uid != uid:
                        continue
                    os.chmod(name, os.lstat(name).st_mode | 0o700)
                except OSError:
                    continue
        shutil.rmtree(path)

    @staticmethod
    def effective_mtime(path) -> float:
        """Age of an entry, counting its immediate children.

        A directory's own mtime moves only when its direct entries change, so a
        build tree whose churn happens deeper down can look untouched for
        months while it is in active use. Checking one level in catches that at
        the cost of a single listdir. ctime is deliberately not consulted: it
        moves for metadata changes that say nothing about whether the content
        is still wanted.
        """
        try:
            newest = os.lstat(path).st_mtime
        except OSError:
            return time.time()
        if os.path.islink(path) or not os.path.isdir(path):
            return newest
        try:
            names = os.listdir(path)[:MAX_ENTRIES_PER_ROOT]
        except OSError:
            return time.time()
        for name in names:
            try:
                newest = max(newest, os.lstat(os.path.join(path, name)).st_mtime)
            except OSError:
                continue
        return newest

    @staticmethod
    def size_of(path) -> int:
        try:
            info = os.lstat(path)
        except OSError:
            return 0
        if not os.path.isdir(path) or os.path.islink(path):
            return info.st_size
        total = 0
        for current, dirs, files in os.walk(path, followlinks=False):
            for name in files:
                try:
                    total += os.lstat(os.path.join(current, name)).st_size
                except OSError:
                    continue
        return total

    def sweep_expiring_paths(self):
        """Remove exactly the configured paths, once unused for long enough."""
        if not self.args.expiring:
            self.record("expiring_paths", "SKIPPED")
            return
        now = time.time()
        detail = {}
        worst = "OK"
        for path, days in self.args.expiring:
            entry = {"older_than_days": days, "removed": False, "bytes": 0}
            if not os.path.exists(path) and not os.path.islink(path):
                entry["skipped"] = "absent"
                detail[path] = entry
                continue
            if self.effective_mtime(path) >= now - days * 86400:
                entry["skipped"] = "within the window"
                detail[path] = entry
                continue
            entry["bytes"] = self.size_of(path)
            if not self.apply:
                entry["removed"] = True
                detail[path] = entry
                continue
            try:
                if os.path.islink(path) or not os.path.isdir(path):
                    os.unlink(path)
                else:
                    shutil.rmtree(path)
                entry["removed"] = True
            except OSError as exc:
                entry["error"] = exc.__class__.__name__
                worst = "DEGRADED"
            detail[path] = entry
        self.record("expiring_paths", worst, applied=self.apply, paths=detail)


    # -- merged worktrees ---------------------------------------------------

    def live_session_paths(self):
        """Paths currently held by a session, which are never reclaimed."""
        held = set()
        for profile in self.profiles():
            ok, out, _ = run([self.args.agent_deck, "-p", profile, "list", "--json"],
                             timeout=120)
            if not ok:
                # Unknown occupancy is not empty occupancy. Returning None makes
                # the caller skip reclaim entirely rather than delete a worktree
                # an agent is sitting in.
                return None
            rows = load_json(out)
            if not isinstance(rows, list):
                return None
            for row in rows:
                if isinstance(row, dict) and isinstance(row.get("path"), str):
                    held.add(real(row["path"]))
        return held

    def worktrees(self, repo):
        ok, out, summary = run([self.args.git, "-C", repo, "worktree", "list",
                                "--porcelain"], timeout=120)
        if not ok:
            return None, summary
        trees, current = [], None
        for line in out.splitlines():
            if line.startswith("worktree "):
                current = {"path": line.split(" ", 1)[1]}
            elif line.startswith("branch ") and current is not None:
                ref = line.split(" ", 1)[1]
                prefix = "refs/heads/"
                current["branch"] = ref[len(prefix):] if ref.startswith(prefix) else ref
                trees.append(current)
                current = None
            elif line.startswith("detached"):
                current = None
        return trees, "ok"

    def pull_requests(self, repo):
        """Head branch -> pull request, read-only.

        A merged pull request is the only evidence that reviewed work is safely
        upstream. Local git cannot supply it: squash-merge rewrites the commits,
        so the branch still looks ahead of main and `git cherry` still reports
        unmerged patches long after the merge landed.
        """
        # The first live run met HTTP 502 and 504 from the GraphQL API on most
        # repositories at once. A failed query is safe -- that repository simply
        # retains everything -- but a daily task that half-fails on a flaky API
        # never finishes its job, so transient failures are retried.
        argv = [self.args.gh, "pr", "list", "--state", "all",
                "--limit", str(self.args.reclaim_pr_limit),
                "--json", "headRefName,headRefOid,state,number,mergedAt"]
        for attempt in range(self.args.gh_attempts):
            ok, out, summary = run(argv, timeout=self.args.gh_timeout, cwd=repo)
            if ok:
                break
            if attempt + 1 < self.args.gh_attempts:
                time.sleep(min(2 ** attempt * 5, 30))
        if not ok:
            return None, summary
        rows = load_json(out)
        if not isinstance(rows, list):
            return None, "pull request list was not a list"
        return {row.get("headRefName"): row for row in rows
                if isinstance(row, dict) and isinstance(row.get("headRefName"), str)}, "ok"

    def reclaim_merged_worktrees(self):
        if not self.args.reclaim_repo:
            self.record("merged_worktrees", "SKIPPED")
            return
        held = self.live_session_paths()
        if held is None:
            self.record("merged_worktrees", "DEGRADED",
                        reason="session occupancy could not be established")
            return

        now = time.time()
        grace = self.args.reclaim_grace_days * 86400
        detail = {}
        worst = "OK"
        for repo in self.args.reclaim_repo:
            entry = {"reclaimed": [], "retained": [], "failed": [], "bytes": 0}
            trees, summary = self.worktrees(repo)
            if trees is None:
                entry["error"] = summary
                worst = "DEGRADED"
                detail[repo] = entry
                continue
            prs, summary = self.pull_requests(repo)
            if prs is None:
                entry["error"] = summary
                worst = "DEGRADED"
                detail[repo] = entry
                continue

            root = real(repo)
            for tree in trees:
                path = real(tree["path"])
                branch = tree.get("branch", "")
                reason = self.retain_reason(root, path, branch, prs, held, now, grace)
                if reason:
                    entry["retained"].append({"branch": branch, "reason": reason})
                    continue
                size = self.size_of(path)
                if not self.apply:
                    entry["reclaimed"].append({"branch": branch, "bytes": size})
                    entry["bytes"] += size
                    continue
                ok, _, summary = run([self.args.git, "-C", root, "worktree",
                                      "remove", path], timeout=600)
                if not ok:
                    # The only objection left is ignored content, typically a
                    # build directory, because tracked cleanliness was checked
                    # above and is what --force would otherwise override.
                    ok, _, summary = run([self.args.git, "-C", root, "worktree",
                                          "remove", "--force", path], timeout=600)
                if ok:
                    entry["reclaimed"].append({"branch": branch, "bytes": size})
                    entry["bytes"] += size
                else:
                    entry["failed"].append({"branch": branch, "summary": summary})
                    worst = "DEGRADED"
            detail[repo] = entry
        self.record("merged_worktrees", worst, applied=self.apply,
                    grace_days=self.args.reclaim_grace_days, repositories=detail)

    def retain_reason(self, root, path, branch, prs, held, now, grace):
        """Why this worktree is kept, or "" when it is safe to reclaim."""
        if path == root:
            return "primary worktree"
        if not branch:
            return "detached head"
        if path in held:
            return "a session is using it"
        pr = prs.get(branch)
        if not pr:
            return "no pull request"
        if pr.get("state") != "MERGED":
            return str(pr.get("state", "unknown")).lower()
        ok, head, _ = run([self.args.git, "-C", path, "rev-parse", "HEAD"],
                          timeout=60)
        if not ok:
            return "head could not be read"
        if head.strip() != pr.get("headRefOid"):
            return "commits after the merged head"
        ok, status, _ = run([self.args.git, "-C", path, "status", "--porcelain"],
                            timeout=120)
        if not ok:
            return "status could not be read"
        if status.strip():
            return "uncommitted changes"
        merged_at = pr.get("mergedAt")
        if grace and isinstance(merged_at, str):
            try:
                stamp = time.mktime(time.strptime(merged_at, "%Y-%m-%dT%H:%M:%SZ"))
            except ValueError:
                return "merge time could not be read"
            if stamp - time.timezone > now - grace:
                return "inside the grace window"
        return ""

    # -- drift --------------------------------------------------------------

    def report_drift(self):
        """Observation only. Source is never pulled or applied by a timer."""
        if not self.args.repo:
            self.record("drift", "SKIPPED")
            return
        detail = {}
        for repo in self.args.repo:
            ok, out, summary = run([self.args.git, "-C", repo, "status",
                                    "--porcelain=v1", "--branch"], timeout=60)
            if not ok:
                detail[repo] = {"ok": False, "summary": summary}
                continue
            lines = out.splitlines()
            branch = lines[0] if lines else ""
            detail[repo] = {
                "ok": True,
                "dirty_files": max(0, len(lines) - 1),
                "ahead": "ahead" in branch,
                "behind": "behind" in branch,
            }
        self.record("drift", "OK", repositories=detail)

    # -- tmux ---------------------------------------------------------------

    def claimed_tmux_sessions(self):
        """tmux session names an Agent Deck row still claims.

        A row claims its pane whatever its status says: a stopped or errored
        row is still the thing an operator comes back to. Returns None when any
        profile cannot be listed, because an unknown claim set is not an empty
        one, and the caller must then reap nothing.
        """
        claimed = set()
        for profile in self.profiles():
            ok, out, _ = run([self.args.agent_deck, "-p", profile, "list", "--json"],
                             timeout=120)
            if not ok:
                return None
            rows = load_json(out)
            if not isinstance(rows, list):
                return None
            for row in rows:
                if isinstance(row, dict) and isinstance(row.get("tmux_session"), str):
                    claimed.add(row["tmux_session"])
        return claimed

    def tmux_sessions(self, socket):
        """(server_alive, [(name, attached, activity)]) for one tmux socket.

        A dead server is not an error here: its leftover socket file is exactly
        what this task exists to find, so the caller reads a false first value
        as "no server", not as a fault.
        """
        ok, out, _ = run([self.args.tmux, "-S", socket, "list-sessions", "-F",
                          "#{session_name}\t#{session_attached}\t#{session_activity}"],
                         timeout=self.args.tmux_timeout)
        if not ok:
            return False, []
        found = []
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) != 3:
                continue
            try:
                found.append((parts[0], int(parts[1]), int(parts[2])))
            except ValueError:
                continue
        return True, found

    # -- stale agent binaries ------------------------------------------------

    def stale_agent_pids(self):
        """Agent processes whose own binary has been deleted under them.

        The hourly CLI updater replaces ~/.npm-global's codex and claude in
        place. A process already running keeps the old inode, so /proc/<pid>/exe
        reads "<path> (deleted)" and the agent goes on speaking a protocol the
        server may no longer accept for it. On 2026-10-14 box 4 held 63 such
        codex processes, all started from 0.145.0, and every turn they took
        came back as:

            The 'gpt-6-luna' model is not supported when using Codex with a
            ChatGPT account.

        which reads as a withdrawn model and is really a withdrawn client.
        """
        root = self.args.proc_root
        wanted = frozenset(self.args.stale_agent_tool)
        found = {}
        try:
            entries = sorted(os.listdir(root))
        except OSError:
            return None
        for name in entries:
            if not name.isdigit():
                continue
            try:
                with open(os.path.join(root, name, "comm"), "r") as fh:
                    comm = fh.read().strip()
            except OSError:
                continue
            if comm not in wanted:
                continue
            try:
                target = os.readlink(os.path.join(root, name, "exe"))
            except OSError:
                # A process that exits mid-scan is not a finding.
                continue
            if target.endswith(" (deleted)"):
                found[int(name)] = comm
        return found

    def process_ancestry(self, pid):
        """pid and its ancestors, nearest first, bounded against a cycle."""
        chain = []
        current = pid
        for _ in range(MAX_PROCESS_DEPTH):
            chain.append(current)
            try:
                with open(os.path.join(self.args.proc_root, str(current), "stat"), "r") as fh:
                    stat_line = fh.read()
            except OSError:
                break
            # The second field is the executable name in parentheses and may
            # itself contain spaces or parentheses, so split after the last one.
            tail = stat_line.rpartition(")")[2].split()
            if len(tail) < 2 or not tail[1].isdigit():
                break
            parent = int(tail[1])
            if parent <= 1 or parent in chain:
                break
            current = parent
        return chain

    def tmux_pane_owners(self):
        """{pane pid: tmux session name} across the sockets we protect.

        Those are the sockets Agent Deck itself runs rows on; a socket nobody
        protects is test litter, and sweep_tmux already owns it.
        """
        owners = {}
        sockets = list(self.args.protect_tmux_socket) or ["default"]
        for socket in sockets:
            ok, out, _ = run([self.args.tmux, "-L", socket, "list-panes", "-a", "-F",
                              "#{session_name}\t#{pane_pid}"],
                             timeout=self.args.tmux_timeout)
            if not ok:
                continue
            for line in out.splitlines():
                name, _, pane = line.partition("\t")
                if name and pane.strip().isdigit():
                    owners[int(pane.strip())] = name
        return owners

    def recycle_stale_agents(self):
        """Restart rows whose agent is running a binary that no longer exists.

        A restart is the whole fix: the row keeps its id, its title and its
        transcript, and comes back on the binary that is on disk now. It is
        still destructive to anything in flight, so a running row is left for
        the next run, and a row someone is watching or one that is protected is
        never touched -- the same three guards stop_idle_sessions uses.
        """
        if not self.args.recycle_stale_agents:
            self.record("stale_agents", "SKIPPED")
            return
        if not os.path.isdir(self.args.proc_root):
            # Not Linux, or a sandbox without /proc: report it rather than
            # claiming a clean box.
            self.record("stale_agents", "SKIPPED",
                        summary=f"{self.args.proc_root} is not readable")
            return
        stale = self.stale_agent_pids()
        if stale is None:
            self.record("stale_agents", "DEGRADED", applied=self.apply,
                        summary=f"{self.args.proc_root} could not be listed")
            return
        owners = self.tmux_pane_owners()
        panes = {}
        for pid, comm in stale.items():
            for ancestor in self.process_ancestry(pid):
                session = owners.get(ancestor)
                if session:
                    panes.setdefault(session, []).append({"pid": pid, "tool": comm})
                    break
        detail = {}
        worst = "OK"
        for profile in self.profiles():
            ok, out, summary = run([self.args.agent_deck, "-p", profile, "list", "--json"],
                                   timeout=120)
            rows = load_json(out) if ok else None
            if not ok or not isinstance(rows, list):
                detail[profile] = {"ok": False,
                                   "summary": summary if not ok else "list did not return an array"}
                worst = "DEGRADED"
                continue
            restarted, failed = [], []
            kept = {"running": 0, "watched": 0, "protected": 0, "other": 0}
            for row in rows:
                if not isinstance(row, dict) or not isinstance(row.get("id"), str):
                    continue
                processes = panes.get(row.get("tmux_session"))
                if not processes:
                    continue
                status = row.get("status")
                if status == "running":
                    # Work in flight. The deleted binary only bites on the next
                    # request, so this row is tomorrow's.
                    kept["running"] += 1
                    continue
                if status not in ("waiting", "idle"):
                    kept["other"] += 1
                    continue
                if row.get("title") in self.args.protect_session_title:
                    kept["protected"] += 1
                    continue
                if row.get("viewers"):
                    kept["watched"] += 1
                    continue
                entry = {"id": row["id"], "title": row.get("title"),
                         "tools": sorted({p["tool"] for p in processes}),
                         "processes": len(processes)}
                if not self.apply:
                    restarted.append(entry)
                    continue
                ok, _, summary = run([self.args.agent_deck, "-p", profile,
                                      "session", "restart", row["id"], "--force"],
                                     timeout=self.args.restart_timeout)
                if ok:
                    restarted.append(entry)
                else:
                    failed.append({"id": row["id"], "summary": summary})
                    worst = "DEGRADED"
            detail[profile] = {"ok": True, "restarted": restarted, "failed": failed,
                               "kept": kept}
        self.record("stale_agents", worst, applied=self.apply,
                    stale_processes=len(stale), stale_panes=len(panes),
                    profiles=detail)

    def sweep_tmux(self):
        """Kill abandoned tmux sessions and delete the sockets left behind.

        Test harnesses and crashed runs leave both: sessions whose row was
        deleted long ago, and socket files whose server is gone. Neither is
        reachable from the TUI, so nothing removes them, and a box accumulates
        hundreds.

        Three conditions must all hold before a session is killed, and any one
        of them alone keeps it: no Agent Deck row claims the name, no client is
        attached, and the session has been idle past the window. A socket file
        is deleted only when its server does not answer at all, and a protected
        socket file is never deleted whatever its server says.
        """
        if not self.args.tmux_socket_root:
            self.record("tmux", "SKIPPED")
            return
        claimed = self.claimed_tmux_sessions()
        if claimed is None:
            # Reaping against an unknown claim set would kill live work.
            self.record("tmux", "DEGRADED", applied=self.apply,
                        summary="agent-deck rows could not be listed")
            return
        cutoff = time.time() - self.args.tmux_idle_days * 86400
        protected = frozenset(self.args.protect_tmux_socket)
        detail = {}
        worst = "OK"
        for root in self.args.tmux_socket_root:
            entry = {"idle_days": self.args.tmux_idle_days, "killed": [],
                     "retained": 0, "sockets_removed": [], "protected": 0,
                     "foreign": 0, "failed": [], "truncated": False}
            if os.path.islink(root) or not os.path.isdir(root):
                entry["skipped"] = "root is missing or not a directory"
                detail[root] = entry
                continue
            try:
                names = sorted(os.listdir(root))
            except OSError as exc:
                entry["skipped"] = exc.__class__.__name__
                worst = "DEGRADED"
                detail[root] = entry
                continue
            if len(names) > MAX_ENTRIES_PER_ROOT:
                names = names[:MAX_ENTRIES_PER_ROOT]
                entry["truncated"] = True
            for name in names:
                path = os.path.join(root, name)
                if not SOCKET_NAME.match(name):
                    continue
                try:
                    info = os.lstat(path)
                except OSError:
                    continue
                if not stat.S_ISSOCK(info.st_mode):
                    continue
                # Another user's socket on a shared root is not ours to touch.
                if info.st_uid != os.getuid():
                    entry["foreign"] += 1
                    continue
                # Protection covers the socket file, not the sessions on it.
                # The conductor's socket also carries the test harness litter
                # this task exists for, and skipping it whole hid 45 abandoned
                # sessions. A live pane is already safe three other ways.
                keep_socket = name in protected
                if keep_socket:
                    entry["protected"] += 1
                alive, sessions = self.tmux_sessions(path)
                if alive:
                    for session, attached, activity in sessions:
                        if session in claimed or attached > 0 or activity >= cutoff:
                            entry["retained"] += 1
                            continue
                        if not self.apply:
                            entry["killed"].append({"socket": name, "session": session})
                            continue
                        ok, _, summary = run([self.args.tmux, "-S", path,
                                              "kill-session", "-t", session],
                                             timeout=self.args.tmux_timeout)
                        if ok:
                            entry["killed"].append({"socket": name, "session": session})
                        else:
                            entry["failed"].append({"socket": name, "session": session,
                                                    "error": summary})
                            worst = "DEGRADED"
                    # A server exits with its last session, so ask again rather
                    # than assume either outcome.
                    alive, _ = self.tmux_sessions(path)
                if alive or keep_socket:
                    continue
                if not self.apply:
                    entry["sockets_removed"].append(name)
                    continue
                try:
                    os.unlink(path)
                    entry["sockets_removed"].append(name)
                except OSError as exc:
                    entry["failed"].append({"socket": name,
                                            "error": exc.__class__.__name__})
                    worst = "DEGRADED"
            detail[root] = entry
        self.record("tmux", worst, applied=self.apply, roots=detail)

    # -- driver -------------------------------------------------------------

    def now(self):
        return time.time()

    def run_all(self):
        # Stopping runs before the sweep so a row stopped today is reclaimed by
        # a later run, never by this one: two separate windows, two separate
        # days, and a chance to notice in between.
        self.recycle_stale_agents()
        self.stop_idle_sessions()
        self.sweep_sessions()
        self.sweep_groups()
        self.prune_worktrees()
        self.collect_nix_garbage()
        self.sweep_artifacts()
        self.sweep_expiring_paths()
        self.reclaim_merged_worktrees()
        self.sweep_tmux()
        self.report_drift()
        degraded = [t for t, r in self.results.items() if r["status"] == "DEGRADED"]
        return {
            "version": VERSION,
            "started": self.started,
            "finished": utc(),
            "applied": self.apply,
            "status": "DEGRADED" if degraded else "OK",
            "degraded_tasks": sorted(degraded),
            "tasks": self.results,
        }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--agent-deck", required=True)
    parser.add_argument("--git", default="git")
    parser.add_argument("--state-dir", required=True)
    parser.add_argument("--report-root")
    parser.add_argument("--profile", action="append", default=[])
    parser.add_argument("--session-retention-days", type=int, default=30)
    parser.add_argument("--stop-idle-days", type=int, default=0,
                        help="stop a waiting session parked this long; 0 never stops one")
    parser.add_argument("--stopped-retention-days", type=int, default=0,
                        help="shorter window for rows an agent already finished with; 0 uses --session-retention-days")
    parser.add_argument("--archived-retention-days", type=int, default=0,
                        help="window for archived rows, which the CLI never offers by itself; 0 never purges them")
    parser.add_argument("--empty-groups", action="store_true")
    parser.add_argument("--protect-session-title", action="append", default=[])
    parser.add_argument("--protect-group", action="append", default=[])
    parser.add_argument("--repo", action="append", default=[])
    parser.add_argument("--artifact", action="append", default=[],
                        metavar="ROOT:DAYS")
    parser.add_argument("--expiring", action="append", default=[],
                        metavar="PATH:DAYS")
    parser.add_argument("--keep-pattern", action="append", default=[])
    parser.add_argument("--gh", default="gh")
    parser.add_argument("--gh-timeout", type=int, default=120)
    parser.add_argument("--reclaim-repo", action="append", default=[])
    parser.add_argument("--reclaim-grace-days", type=int, default=0)
    parser.add_argument("--reclaim-pr-limit", type=int, default=200)
    parser.add_argument("--gh-attempts", type=int, default=3)
    parser.add_argument("--nix-generations-days", type=int, default=None)
    parser.add_argument("--nix-timeout", type=int, default=1800)
    parser.add_argument("--tmux", default="tmux")
    parser.add_argument("--tmux-socket-root", action="append", default=[],
                        metavar="DIR")
    parser.add_argument("--tmux-idle-days", type=int, default=7)
    parser.add_argument("--tmux-timeout", type=int, default=30)
    parser.add_argument("--protect-tmux-socket", action="append", default=[])
    parser.add_argument("--recycle-stale-agents", action="store_true",
                        help="restart rows whose agent binary was replaced under it")
    parser.add_argument("--stale-agent-tool", action="append", default=[],
                        help="process name to treat as an agent (default: codex, claude)")
    parser.add_argument("--proc-root", default="/proc")
    parser.add_argument("--restart-timeout", type=int, default=180)
    parser.add_argument("--apply", action="store_true",
                        help="perform deletions; without it every task is a preview")
    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.session_retention_days < 1:
            raise Rejected("--session-retention-days must be positive")
        if args.tmux_idle_days < 1:
            raise Rejected("--tmux-idle-days must be positive")
        if args.stop_idle_days < 0:
            raise Rejected("--stop-idle-days cannot be negative")
        if args.stopped_retention_days < 0 or args.archived_retention_days < 0:
            raise Rejected("retention windows cannot be negative")
        if args.stopped_retention_days > args.session_retention_days:
            # A stopped row is a subset of an idle one; a longer window for it
            # would be silently ignored, because the CLI never lists it later
            # than the general window does.
            raise Rejected("--stopped-retention-days cannot exceed --session-retention-days")
        if args.restart_timeout < 1:
            raise Rejected("--restart-timeout must be positive")
        if not args.stale_agent_tool:
            args.stale_agent_tool = ["codex", "claude"]
        args.tmux_socket_root = [check_root(root) for root in args.tmux_socket_root]
        args.artifact = [parse_artifact_rule(rule) for rule in args.artifact]
        args.expiring = [parse_expiring_rule(rule) for rule in args.expiring]
        for pattern in args.keep_pattern:
            re.compile(pattern)
    except (Rejected, re.error) as exc:
        print(json.dumps({"status": "REJECTED", "reason": str(exc)}), file=sys.stderr)
        return 2

    os.makedirs(args.state_dir, mode=0o700, exist_ok=True)
    lock_path = os.path.join(args.state_dir, "janitor.lock")
    handle = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            # Another invocation owns the box. Overlapping deletions are how a
            # janitor races itself into deleting what the other is reading.
            print(json.dumps({"status": "LOCKED"}), file=sys.stderr)
            return 3

        janitor = Janitor(args)
        janitor.started = utc()
        report = janitor.run_all()
    finally:
        os.close(handle)

    body = json.dumps(report, indent=2, sort_keys=True)
    if args.report_root:
        os.makedirs(args.report_root, mode=0o700, exist_ok=True)
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        path = os.path.join(args.report_root, f"janitor-{stamp}.json")
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as fh:
            fh.write(body + "\n")
    print(body)
    return 1 if report["status"] == "DEGRADED" else 0


if __name__ == "__main__":
    sys.exit(main())
