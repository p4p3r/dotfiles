#!/usr/bin/env python3
"""Deterministic, read-only Agent Deck maintenance inventory collector."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
from typing import Any, Callable


FORMAT_VERSION = 2
FIXTURE_VERSION = 1
EVENT_VERSION = 2
MAX_INPUT_BYTES = 4_194_304
MAX_STATE_BYTES = 1_048_576
MAX_COMMAND_BYTES = 4_194_304
MAX_GENERATION = 9_223_372_036_854_775_807
COMMAND_TIMEOUT_SECONDS = 15.0
PATH_LIMIT = 4_096

EXIT_SILENT = 0
EXIT_CHANGED = 10
EXIT_DEGRADED = 20
EXIT_CHANGED_DEGRADED = 30
EXIT_INVALID_INPUT = 64
EXIT_STATE_ERROR = 70

SESSION_ID_RE = re.compile(r"^[0-9a-f]{8,20}-[0-9]{9,20}$")
PROFILE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
HEX_24_RE = re.compile(r"^[a-z_]+:[0-9a-f]{24}$")
INSTANCE_ID_RE = re.compile(r"^[0-9a-f]{32}$")
HEX_64_RE = re.compile(r"^[0-9a-f]{64}$")

SOURCE_STATUSES = {"OK", "UNAVAILABLE", "MALFORMED"}
FIXTURE_WORKTREE_STATUSES = {"CLEAN", "DIRTY", "UNKNOWN"}
SESSION_STATUSES = {
    "RUNNING",
    "QUEUED",
    "WAITING",
    "IDLE",
    "ERROR",
    "STOPPED",
    "UNKNOWN",
}
SESSION_SUBSTATES = {
    "NONE",
    "RUNNING",
    "IDLE_AT_EMPTY_PROMPT",
    "MODEL_UNAVAILABLE",
    "AUTH_401",
    "USAGE_LIMIT",
    "UNKNOWN",
}
FILESYSTEM_BANDS = {"NORMAL", "WARN", "CRITICAL", "UNKNOWN"}
CANDIDATE_KINDS = {"SESSION", "WORKTREE", "FILESYSTEM", "SOURCE"}
CANDIDATE_REASONS = {
    "AGENT_DECK_UNAVAILABLE",
    "AGENT_DECK_MALFORMED",
    "GIT_REPOSITORY_UNAVAILABLE",
    "GIT_REPOSITORY_MALFORMED",
    "FILESYSTEM_UNAVAILABLE",
    "FILESYSTEM_MALFORMED",
    "SESSION_ERROR",
    "SESSION_STOPPED",
    "SESSION_ARCHIVED",
    "SESSION_UNKNOWN_STATUS",
    "SESSION_UNKNOWN_SUBSTATE",
    "SESSION_HEALTH_MODEL_UNAVAILABLE",
    "SESSION_HEALTH_AUTH_401",
    "SESSION_HEALTH_USAGE_LIMIT",
    "WORKTREE_DIRTY",
    "WORKTREE_UNKNOWN",
    "WORKTREE_PRUNABLE",
    "WORKTREE_LOCKED",
    "FILESYSTEM_WARN",
    "FILESYSTEM_CRITICAL",
    "FILESYSTEM_UNKNOWN",
}
DEGRADED_REASONS = {
    "AGENT_DECK_UNAVAILABLE",
    "AGENT_DECK_MALFORMED",
    "GIT_REPOSITORY_UNAVAILABLE",
    "GIT_REPOSITORY_MALFORMED",
    "FILESYSTEM_UNAVAILABLE",
    "FILESYSTEM_MALFORMED",
    "SESSION_UNKNOWN_STATUS",
    "SESSION_UNKNOWN_SUBSTATE",
    "WORKTREE_UNKNOWN",
    "FILESYSTEM_UNKNOWN",
}


class InputError(Exception):
    """A sanitized fixture or CLI validation failure."""


class StateError(Exception):
    """A sanitized state validation failure."""


class StateWriteNotVerified(Exception):
    """A state write whose outcome cannot be claimed successful."""


class CollectionUnavailable(Exception):
    """A read-only source could not be queried."""


class CollectionMalformed(Exception):
    """A read-only source returned malformed data."""


class DuplicateKeyError(ValueError):
    """Raised for duplicate JSON object keys."""


def no_duplicate_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateKeyError("duplicate key")
        result[key] = value
    return result


def reject_json_constant(_value: str) -> None:
    raise ValueError("non-finite JSON number")


def parse_json_bytes(raw: bytes, *, state: bool) -> Any:
    error = StateError if state else InputError
    try:
        rendered = raw.decode("utf-8", errors="strict")
        return json.loads(
            rendered,
            object_pairs_hook=no_duplicate_object,
            parse_constant=reject_json_constant,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, DuplicateKeyError, ValueError) as exc:
        raise error("invalid JSON") from exc


def exact_fields(value: Any, fields: set[str], *, state: bool) -> dict[str, Any]:
    error = StateError if state else InputError
    if not isinstance(value, dict) or set(value) != fields:
        raise error("invalid object fields")
    return value


def strict_int(
    value: Any,
    *,
    minimum: int = 0,
    maximum: int | None = None,
    state: bool = False,
) -> int:
    error = StateError if state else InputError
    if (
        isinstance(value, bool)
        or not isinstance(value, int)
        or value < minimum
        or (maximum is not None and value > maximum)
    ):
        raise error("invalid integer")
    return value


def strict_bool(value: Any, *, state: bool = False) -> bool:
    error = StateError if state else InputError
    if not isinstance(value, bool):
        raise error("invalid boolean")
    return value


def bounded_string(
    value: Any,
    *,
    maximum: int,
    state: bool = False,
    allow_empty: bool = False,
) -> str:
    error = StateError if state else InputError
    if (
        not isinstance(value, str)
        or len(value) > maximum
        or (not allow_empty and not value)
        or "\x00" in value
    ):
        raise error("invalid string")
    return value


def normalized_path(value: Any) -> str:
    rendered = bounded_string(value, maximum=PATH_LIMIT)
    return os.path.abspath(os.path.normpath(rendered))


def stable_ref(kind: str, value: str) -> str:
    digest = hashlib.sha256((kind + "\0" + value).encode("utf-8")).hexdigest()[:24]
    return f"{kind}:{digest}"


def default_state_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    base = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return base / "agent-deck" / "maintenance-collector.json"


def absolute_path(value: str | None) -> Path:
    path = Path(value) if value else default_state_path()
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.absolute()


def read_bounded_regular(path: Path, limit: int, *, state: bool) -> bytes:
    error = StateError if state else InputError
    try:
        before = path.lstat()
    except OSError as exc:
        raise error("cannot inspect file") from exc
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
        raise error("unsafe file type")
    if state and (
        before.st_uid != os.geteuid() or stat.S_IMODE(before.st_mode) != 0o600
    ):
        raise StateError("unsafe state permissions")
    if before.st_size > limit:
        raise error("file too large")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise error("cannot open file") from exc
    try:
        current = os.fstat(descriptor)
        if (
            not stat.S_ISREG(current.st_mode)
            or (before.st_dev, before.st_ino) != (current.st_dev, current.st_ino)
        ):
            raise error("file changed during open")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, min(65_536, limit + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > limit:
                raise error("file too large")
        return b"".join(chunks)
    except OSError as exc:
        raise error("cannot read file") from exc
    finally:
        os.close(descriptor)


def validate_fixture(value: Any) -> dict[str, Any]:
    top = exact_fields(
        value,
        {"fixture_version", "agent_deck", "git_repositories", "filesystems"},
        state=False,
    )
    if strict_int(top["fixture_version"]) != FIXTURE_VERSION:
        raise InputError("unsupported fixture version")

    agent_deck = exact_fields(top["agent_deck"], {"status", "sessions"}, state=False)
    agent_status = bounded_string(agent_deck["status"], maximum=32)
    if agent_status not in SOURCE_STATUSES or not isinstance(agent_deck["sessions"], list):
        raise InputError("invalid Agent Deck fixture")
    sessions: list[dict[str, Any]] = []
    seen_sessions: set[str] = set()
    for raw in agent_deck["sessions"]:
        item = exact_fields(
            raw,
            {"id", "status", "substate", "path", "parent_project_path", "archived"},
            state=False,
        )
        session_id = bounded_string(item["id"], maximum=64)
        if not SESSION_ID_RE.fullmatch(session_id) or session_id in seen_sessions:
            raise InputError("invalid session identity")
        seen_sessions.add(session_id)
        status_value = bounded_string(item["status"], maximum=64)
        substate_value = bounded_string(
            item["substate"], maximum=64, allow_empty=True
        )
        path_value = None if item["path"] is None else normalized_path(item["path"])
        parent_value = (
            None
            if item["parent_project_path"] in (None, "")
            else normalized_path(item["parent_project_path"])
        )
        sessions.append(
            {
                "id": session_id,
                "status": status_value,
                "substate": substate_value,
                "path": path_value,
                "parent_project_path": parent_value,
                "archived": strict_bool(item["archived"]),
            }
        )
    if agent_status != "OK" and sessions:
        raise InputError("failed Agent Deck source cannot contain sessions")

    if not isinstance(top["git_repositories"], list):
        raise InputError("invalid repository fixture")
    repositories: list[dict[str, Any]] = []
    seen_repositories: set[str] = set()
    for raw in top["git_repositories"]:
        repo = exact_fields(raw, {"repo_path", "status", "worktrees"}, state=False)
        repo_path = normalized_path(repo["repo_path"])
        if repo_path in seen_repositories:
            raise InputError("duplicate repository")
        seen_repositories.add(repo_path)
        repo_status = bounded_string(repo["status"], maximum=32)
        if repo_status not in SOURCE_STATUSES or not isinstance(repo["worktrees"], list):
            raise InputError("invalid repository fixture")
        worktrees: list[dict[str, Any]] = []
        seen_worktrees: set[str] = set()
        for raw_worktree in repo["worktrees"]:
            worktree = exact_fields(
                raw_worktree,
                {"path", "status", "prunable", "locked"},
                state=False,
            )
            worktree_path = normalized_path(worktree["path"])
            if worktree_path in seen_worktrees:
                raise InputError("duplicate worktree")
            seen_worktrees.add(worktree_path)
            worktree_status = bounded_string(worktree["status"], maximum=32)
            if worktree_status not in FIXTURE_WORKTREE_STATUSES:
                raise InputError("invalid worktree status")
            worktrees.append(
                {
                    "path": worktree_path,
                    "status": worktree_status,
                    "prunable": strict_bool(worktree["prunable"]),
                    "locked": strict_bool(worktree["locked"]),
                }
            )
        if repo_status != "OK" and worktrees:
            raise InputError("failed repository source cannot contain worktrees")
        repositories.append(
            {"repo_path": repo_path, "status": repo_status, "worktrees": worktrees}
        )

    if not isinstance(top["filesystems"], list) or not top["filesystems"]:
        raise InputError("invalid filesystem fixture")
    filesystems: list[dict[str, Any]] = []
    seen_filesystems: set[str] = set()
    for raw in top["filesystems"]:
        filesystem = exact_fields(
            raw, {"path", "status", "total_bytes", "used_bytes"}, state=False
        )
        filesystem_path = normalized_path(filesystem["path"])
        if filesystem_path in seen_filesystems:
            raise InputError("duplicate filesystem")
        seen_filesystems.add(filesystem_path)
        filesystem_status = bounded_string(filesystem["status"], maximum=32)
        if filesystem_status not in SOURCE_STATUSES:
            raise InputError("invalid filesystem status")
        total = strict_int(filesystem["total_bytes"])
        used = strict_int(filesystem["used_bytes"])
        if filesystem_status == "OK":
            if total <= 0 or used > total:
                raise InputError("invalid filesystem capacity")
        elif total != 0 or used != 0:
            raise InputError("failed filesystem source must use zero capacity")
        filesystems.append(
            {
                "path": filesystem_path,
                "status": filesystem_status,
                "total_bytes": total,
                "used_bytes": used,
            }
        )

    return {
        "agent_deck": {"status": agent_status, "sessions": sessions},
        "git_repositories": repositories,
        "filesystems": filesystems,
    }


def load_fixture(path: Path) -> dict[str, Any]:
    raw = read_bounded_regular(path, MAX_INPUT_BYTES, state=False)
    return validate_fixture(parse_json_bytes(raw, state=False))


def default_runner(
    argv: list[str], timeout: float, limit: int
) -> subprocess.CompletedProcess[bytes]:
    try:
        result = subprocess.run(
            argv,
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            shell=False,
        )
    except (FileNotFoundError, PermissionError, subprocess.TimeoutExpired, OSError) as exc:
        raise CollectionUnavailable("command unavailable") from exc
    if len(result.stdout) > limit or len(result.stderr) > limit:
        raise CollectionUnavailable("command output exceeded bound")
    return result


def parse_agent_deck_sessions(raw: bytes) -> list[dict[str, Any]]:
    try:
        value = parse_json_bytes(raw, state=False)
    except InputError as exc:
        raise CollectionMalformed("malformed Agent Deck JSON") from exc
    if not isinstance(value, list):
        raise CollectionMalformed("Agent Deck list was not an array")
    sessions: list[dict[str, Any]] = []
    seen: set[str] = set()
    try:
        for raw_item in value:
            if not isinstance(raw_item, dict):
                raise CollectionMalformed("invalid session object")
            session_id = bounded_string(raw_item.get("id"), maximum=64)
            if not SESSION_ID_RE.fullmatch(session_id) or session_id in seen:
                raise CollectionMalformed("invalid session identity")
            seen.add(session_id)
            status_value = bounded_string(raw_item.get("status"), maximum=64)
            substate_raw = raw_item.get("substate", "")
            substate_value = bounded_string(
                substate_raw, maximum=64, allow_empty=True
            )
            raw_path = raw_item.get("path")
            path_value = None if raw_path in (None, "") else normalized_path(raw_path)
            raw_parent = raw_item.get("parent_project_path")
            parent_value = (
                None if raw_parent in (None, "") else normalized_path(raw_parent)
            )
            archived = raw_item.get("archived", False)
            if not isinstance(archived, bool):
                raise CollectionMalformed("invalid archived marker")
            sessions.append(
                {
                    "id": session_id,
                    "status": status_value,
                    "substate": substate_value,
                    "path": path_value,
                    "parent_project_path": parent_value,
                    "archived": archived,
                }
            )
    except InputError as exc:
        raise CollectionMalformed("malformed Agent Deck list") from exc
    return sessions


def parse_git_worktree_list(raw: bytes) -> list[dict[str, Any]]:
    try:
        rendered = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise CollectionMalformed("invalid git worktree encoding") from exc
    blocks = [block for block in rendered.split("\x00\x00") if block]
    if not blocks:
        raise CollectionMalformed("empty git worktree list")
    worktrees: list[dict[str, Any]] = []
    seen: set[str] = set()
    for block in blocks:
        fields = [field for field in block.split("\x00") if field]
        if not fields or not fields[0].startswith("worktree "):
            raise CollectionMalformed("missing worktree field")
        try:
            path = normalized_path(fields[0][len("worktree ") :])
        except InputError as exc:
            raise CollectionMalformed("invalid worktree path") from exc
        if path in seen:
            raise CollectionMalformed("duplicate worktree path")
        seen.add(path)
        locked = False
        prunable = False
        for field in fields[1:]:
            if field.startswith("HEAD ") or field.startswith("branch "):
                continue
            if field == "detached" or field == "bare":
                continue
            if field == "locked" or field.startswith("locked "):
                locked = True
                continue
            if field == "prunable" or field.startswith("prunable "):
                prunable = True
                continue
            raise CollectionMalformed("unknown worktree field")
        worktrees.append(
            {"path": path, "status": "UNKNOWN", "prunable": prunable, "locked": locked}
        )
    return worktrees


def collect_live(
    *,
    agent_deck: str,
    profile: str,
    git: str,
    repositories: list[str],
    filesystems: list[str],
    runner: Callable[[list[str], float, int], Any] = default_runner,
    disk_usage: Callable[[str], Any] = shutil.disk_usage,
) -> dict[str, Any]:
    agent_command = [agent_deck, "-p", profile, "list", "--json"]
    try:
        result = runner(agent_command, COMMAND_TIMEOUT_SECONDS, MAX_COMMAND_BYTES)
        if result.returncode != 0:
            raise CollectionUnavailable("Agent Deck command failed")
        sessions = parse_agent_deck_sessions(result.stdout)
        agent_observation = {"status": "OK", "sessions": sessions}
    except CollectionMalformed:
        agent_observation = {"status": "MALFORMED", "sessions": []}
    except (CollectionUnavailable, InputError, AttributeError, TypeError):
        agent_observation = {"status": "UNAVAILABLE", "sessions": []}

    repository_observations: list[dict[str, Any]] = []
    for repository in repositories:
        repo_path = normalized_path(repository)
        command = [git, "-C", repo_path, "worktree", "list", "--porcelain", "-z"]
        try:
            result = runner(command, COMMAND_TIMEOUT_SECONDS, MAX_COMMAND_BYTES)
            if result.returncode != 0:
                raise CollectionUnavailable("git worktree list failed")
            worktrees = parse_git_worktree_list(result.stdout)
        except CollectionMalformed:
            repository_observations.append(
                {"repo_path": repo_path, "status": "MALFORMED", "worktrees": []}
            )
            continue
        except (CollectionUnavailable, InputError, AttributeError, TypeError):
            repository_observations.append(
                {"repo_path": repo_path, "status": "UNAVAILABLE", "worktrees": []}
            )
            continue
        for worktree in worktrees:
            status_command = [
                git,
                "-C",
                worktree["path"],
                "status",
                "--porcelain=v1",
                "-z",
                "--untracked-files=normal",
            ]
            try:
                status_result = runner(
                    status_command, COMMAND_TIMEOUT_SECONDS, MAX_COMMAND_BYTES
                )
                worktree["status"] = (
                    "CLEAN"
                    if status_result.returncode == 0 and not status_result.stdout
                    else "DIRTY"
                    if status_result.returncode == 0
                    else "UNKNOWN"
                )
            except (CollectionUnavailable, AttributeError, TypeError):
                worktree["status"] = "UNKNOWN"
        repository_observations.append(
            {"repo_path": repo_path, "status": "OK", "worktrees": worktrees}
        )

    filesystem_observations: list[dict[str, Any]] = []
    for filesystem in filesystems:
        filesystem_path = normalized_path(filesystem)
        try:
            usage = disk_usage(filesystem_path)
            total = strict_int(usage.total)
            used = strict_int(usage.used)
            if total <= 0 or used > total:
                raise InputError("invalid disk usage")
            filesystem_observations.append(
                {
                    "path": filesystem_path,
                    "status": "OK",
                    "total_bytes": total,
                    "used_bytes": used,
                }
            )
        except (OSError, InputError, AttributeError, TypeError):
            filesystem_observations.append(
                {
                    "path": filesystem_path,
                    "status": "UNAVAILABLE",
                    "total_bytes": 0,
                    "used_bytes": 0,
                }
            )

    return {
        "agent_deck": agent_observation,
        "git_repositories": repository_observations,
        "filesystems": filesystem_observations,
    }


def session_status(value: str) -> str:
    mapping = {
        "running": "RUNNING",
        "queued": "QUEUED",
        "waiting": "WAITING",
        "idle": "IDLE",
        "error": "ERROR",
        "stopped": "STOPPED",
    }
    return mapping.get(value, "UNKNOWN")


def session_substate(value: str) -> str:
    mapping = {
        "": "NONE",
        "running": "RUNNING",
        "idle-at-empty-prompt": "IDLE_AT_EMPTY_PROMPT",
        "model-unavailable": "MODEL_UNAVAILABLE",
        "auth-401": "AUTH_401",
        "usage-limit": "USAGE_LIMIT",
    }
    return mapping.get(value, "UNKNOWN")


def add_candidate(
    candidates: dict[str, dict[str, Any]],
    candidate_id: str,
    kind: str,
    reasons: list[str],
) -> None:
    if not reasons:
        return
    entry = candidates.setdefault(
        candidate_id, {"id": candidate_id, "kind": kind, "reason_codes": []}
    )
    if entry["kind"] != kind:
        raise StateError("candidate identity collision")
    entry["reason_codes"] = sorted(set(entry["reason_codes"]) | set(reasons))


def normalize_observation(
    collected: dict[str, Any], warn_percent: int, critical_percent: int
) -> tuple[dict[str, Any], list[dict[str, Any]], bool]:
    candidates: dict[str, dict[str, Any]] = {}
    agent_status = collected["agent_deck"]["status"]
    if agent_status != "OK":
        add_candidate(
            candidates,
            "source:agent-deck",
            "SOURCE",
            [f"AGENT_DECK_{agent_status}"],
        )

    normalized_sessions: list[dict[str, Any]] = []
    for raw in collected["agent_deck"]["sessions"]:
        status_value = session_status(raw["status"])
        substate_value = session_substate(raw["substate"])
        item = {
            "id": raw["id"],
            "status": status_value,
            "substate": substate_value,
            "archived": raw["archived"],
            "project_ref": (
                stable_ref("project", raw["path"]) if raw["path"] is not None else None
            ),
            "parent_project_ref": (
                stable_ref("project", raw["parent_project_path"])
                if raw["parent_project_path"] is not None
                else None
            ),
        }
        normalized_sessions.append(item)
        reasons: list[str] = []
        if status_value == "ERROR":
            reasons.append("SESSION_ERROR")
        elif status_value == "STOPPED":
            reasons.append("SESSION_STOPPED")
        elif status_value == "UNKNOWN":
            reasons.append("SESSION_UNKNOWN_STATUS")
        if raw["archived"]:
            reasons.append("SESSION_ARCHIVED")
        if substate_value == "MODEL_UNAVAILABLE":
            reasons.append("SESSION_HEALTH_MODEL_UNAVAILABLE")
        elif substate_value == "AUTH_401":
            reasons.append("SESSION_HEALTH_AUTH_401")
        elif substate_value == "USAGE_LIMIT":
            reasons.append("SESSION_HEALTH_USAGE_LIMIT")
        elif substate_value == "UNKNOWN":
            reasons.append("SESSION_UNKNOWN_SUBSTATE")
        add_candidate(candidates, f"session:{raw['id']}", "SESSION", reasons)

    normalized_repositories: list[dict[str, Any]] = []
    normalized_worktrees: list[dict[str, Any]] = []
    for repository in collected["git_repositories"]:
        repo_ref = stable_ref("repository", repository["repo_path"])
        normalized_repositories.append({"id": repo_ref, "status": repository["status"]})
        if repository["status"] != "OK":
            add_candidate(
                candidates,
                f"source:{repo_ref}",
                "SOURCE",
                [f"GIT_REPOSITORY_{repository['status']}"],
            )
        for worktree in repository["worktrees"]:
            worktree_ref = stable_ref(
                "worktree", repo_ref + "\0" + worktree["path"]
            )
            item = {
                "id": worktree_ref,
                "repository_ref": repo_ref,
                "status": worktree["status"],
                "prunable": worktree["prunable"],
                "locked": worktree["locked"],
            }
            normalized_worktrees.append(item)
            reasons = []
            if worktree["status"] == "DIRTY":
                reasons.append("WORKTREE_DIRTY")
            elif worktree["status"] == "UNKNOWN":
                reasons.append("WORKTREE_UNKNOWN")
            if worktree["prunable"]:
                reasons.append("WORKTREE_PRUNABLE")
            if worktree["locked"]:
                reasons.append("WORKTREE_LOCKED")
            add_candidate(candidates, worktree_ref, "WORKTREE", reasons)

    normalized_filesystems: list[dict[str, Any]] = []
    for filesystem in collected["filesystems"]:
        filesystem_ref = stable_ref("filesystem", filesystem["path"])
        if filesystem["status"] != "OK":
            band = "UNKNOWN"
            reasons = [f"FILESYSTEM_{filesystem['status']}"]
        else:
            total = filesystem["total_bytes"]
            used = filesystem["used_bytes"]
            if used * 100 >= total * critical_percent:
                band = "CRITICAL"
                reasons = ["FILESYSTEM_CRITICAL"]
            elif used * 100 >= total * warn_percent:
                band = "WARN"
                reasons = ["FILESYSTEM_WARN"]
            else:
                band = "NORMAL"
                reasons = []
        normalized_filesystems.append(
            {"id": filesystem_ref, "status": filesystem["status"], "band": band}
        )
        add_candidate(candidates, filesystem_ref, "FILESYSTEM", reasons)

    observations = {
        "agent_deck": {"status": agent_status},
        "git_repositories": sorted(normalized_repositories, key=lambda item: item["id"]),
        "filesystems": sorted(normalized_filesystems, key=lambda item: item["id"]),
        "sessions": sorted(normalized_sessions, key=lambda item: item["id"]),
        "worktrees": sorted(normalized_worktrees, key=lambda item: item["id"]),
    }
    candidate_list = sorted(candidates.values(), key=lambda item: item["id"])
    degraded = any(
        reason in DEGRADED_REASONS
        for candidate in candidate_list
        for reason in candidate["reason_codes"]
    )
    return observations, candidate_list, degraded


def fingerprint_material(
    observations: dict[str, Any], candidates: list[dict[str, Any]]
) -> dict[str, Any]:
    return {
        "candidates": candidates,
        "health": [
            {"id": item["id"], "band": item["band"]}
            for item in observations["filesystems"]
        ],
    }


def fingerprint(observations: dict[str, Any], candidates: list[dict[str, Any]]) -> str:
    encoded = json.dumps(
        fingerprint_material(observations, candidates),
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
    ).encode("ascii")
    return hashlib.sha256(encoded).hexdigest()


def new_instance_id() -> str:
    try:
        instance_id = secrets.token_hex(16)
    except (OSError, RuntimeError) as exc:
        raise StateError("cannot create collector identity") from exc
    if INSTANCE_ID_RE.fullmatch(instance_id) is None:
        raise StateError("invalid generated collector identity")
    return instance_id


def new_state(
    observations: dict[str, Any],
    candidates: list[dict[str, Any]],
    *,
    collector_instance_id: str,
    generation: int,
) -> dict[str, Any]:
    return {
        "format_version": FORMAT_VERSION,
        "collector_instance_id": collector_instance_id,
        "generation": generation,
        "observations": observations,
        "candidates": candidates,
        "fingerprint": fingerprint(observations, candidates),
    }


def validate_ref(value: Any, kind: str) -> str:
    rendered = bounded_string(value, maximum=64, state=True)
    if not HEX_24_RE.fullmatch(rendered) or not rendered.startswith(kind + ":"):
        raise StateError("invalid stable reference")
    return rendered


def require_sorted_unique(items: list[dict[str, Any]], key: str) -> None:
    values = [item[key] for item in items]
    if values != sorted(values) or len(values) != len(set(values)):
        raise StateError("state entries are not canonical")


def expected_candidates_from_observations(
    observations: dict[str, Any]
) -> list[dict[str, Any]]:
    expected: dict[str, dict[str, Any]] = {}
    agent_status = observations["agent_deck"]["status"]
    if agent_status != "OK":
        add_candidate(
            expected,
            "source:agent-deck",
            "SOURCE",
            [f"AGENT_DECK_{agent_status}"],
        )
    for repository in observations["git_repositories"]:
        if repository["status"] != "OK":
            add_candidate(
                expected,
                f"source:{repository['id']}",
                "SOURCE",
                [f"GIT_REPOSITORY_{repository['status']}"],
            )
    for item in observations["sessions"]:
        reasons: list[str] = []
        if item["status"] == "ERROR":
            reasons.append("SESSION_ERROR")
        elif item["status"] == "STOPPED":
            reasons.append("SESSION_STOPPED")
        elif item["status"] == "UNKNOWN":
            reasons.append("SESSION_UNKNOWN_STATUS")
        if item["archived"]:
            reasons.append("SESSION_ARCHIVED")
        substate_reason = {
            "MODEL_UNAVAILABLE": "SESSION_HEALTH_MODEL_UNAVAILABLE",
            "AUTH_401": "SESSION_HEALTH_AUTH_401",
            "USAGE_LIMIT": "SESSION_HEALTH_USAGE_LIMIT",
            "UNKNOWN": "SESSION_UNKNOWN_SUBSTATE",
        }.get(item["substate"])
        if substate_reason:
            reasons.append(substate_reason)
        add_candidate(expected, f"session:{item['id']}", "SESSION", reasons)
    for item in observations["worktrees"]:
        reasons = []
        if item["status"] == "DIRTY":
            reasons.append("WORKTREE_DIRTY")
        elif item["status"] == "UNKNOWN":
            reasons.append("WORKTREE_UNKNOWN")
        if item["prunable"]:
            reasons.append("WORKTREE_PRUNABLE")
        if item["locked"]:
            reasons.append("WORKTREE_LOCKED")
        add_candidate(expected, item["id"], "WORKTREE", reasons)
    for item in observations["filesystems"]:
        if item["status"] != "OK":
            reasons = [f"FILESYSTEM_{item['status']}"]
        elif item["band"] == "WARN":
            reasons = ["FILESYSTEM_WARN"]
        elif item["band"] == "CRITICAL":
            reasons = ["FILESYSTEM_CRITICAL"]
        elif item["band"] == "UNKNOWN":
            reasons = ["FILESYSTEM_UNKNOWN"]
        else:
            reasons = []
        add_candidate(expected, item["id"], "FILESYSTEM", reasons)
    return sorted(expected.values(), key=lambda item: item["id"])


def validate_state(value: Any) -> dict[str, Any]:
    top = exact_fields(
        value,
        {
            "format_version",
            "collector_instance_id",
            "generation",
            "observations",
            "candidates",
            "fingerprint",
        },
        state=True,
    )
    if strict_int(top["format_version"], state=True) != FORMAT_VERSION:
        raise StateError("unsupported state version")
    collector_instance_id = bounded_string(
        top["collector_instance_id"], maximum=32, state=True
    )
    if INSTANCE_ID_RE.fullmatch(collector_instance_id) is None:
        raise StateError("invalid collector identity")
    strict_int(top["generation"], maximum=MAX_GENERATION, state=True)
    observations = exact_fields(
        top["observations"],
        {"agent_deck", "git_repositories", "filesystems", "sessions", "worktrees"},
        state=True,
    )
    agent = exact_fields(observations["agent_deck"], {"status"}, state=True)
    agent_status = bounded_string(agent["status"], maximum=32, state=True)
    if agent_status not in SOURCE_STATUSES:
        raise StateError("invalid Agent Deck source state")

    repositories = observations["git_repositories"]
    if not isinstance(repositories, list):
        raise StateError("invalid repository observations")
    for raw in repositories:
        item = exact_fields(raw, {"id", "status"}, state=True)
        validate_ref(item["id"], "repository")
        repository_status = bounded_string(item["status"], maximum=32, state=True)
        if repository_status not in SOURCE_STATUSES:
            raise StateError("invalid repository source state")
    require_sorted_unique(repositories, "id")

    filesystems = observations["filesystems"]
    if not isinstance(filesystems, list) or not filesystems:
        raise StateError("invalid filesystem observations")
    for raw in filesystems:
        item = exact_fields(raw, {"id", "status", "band"}, state=True)
        validate_ref(item["id"], "filesystem")
        filesystem_status = bounded_string(item["status"], maximum=32, state=True)
        filesystem_band = bounded_string(item["band"], maximum=32, state=True)
        if filesystem_status not in SOURCE_STATUSES or filesystem_band not in FILESYSTEM_BANDS:
            raise StateError("invalid filesystem state")
        if filesystem_status == "OK" and filesystem_band == "UNKNOWN":
            raise StateError("inconsistent filesystem state")
        if filesystem_status != "OK" and filesystem_band != "UNKNOWN":
            raise StateError("inconsistent filesystem source state")
    require_sorted_unique(filesystems, "id")

    sessions = observations["sessions"]
    if not isinstance(sessions, list):
        raise StateError("invalid session observations")
    for raw in sessions:
        item = exact_fields(
            raw,
            {"id", "status", "substate", "archived", "project_ref", "parent_project_ref"},
            state=True,
        )
        session_id = bounded_string(item["id"], maximum=64, state=True)
        if not SESSION_ID_RE.fullmatch(session_id):
            raise StateError("invalid session ID")
        status_value = bounded_string(item["status"], maximum=32, state=True)
        substate_value = bounded_string(item["substate"], maximum=32, state=True)
        if status_value not in SESSION_STATUSES or substate_value not in SESSION_SUBSTATES:
            raise StateError("invalid session state")
        strict_bool(item["archived"], state=True)
        for ref in (item["project_ref"], item["parent_project_ref"]):
            if ref is not None:
                validate_ref(ref, "project")
    require_sorted_unique(sessions, "id")
    if agent_status != "OK" and sessions:
        raise StateError("failed Agent Deck source contains sessions")

    worktrees = observations["worktrees"]
    if not isinstance(worktrees, list):
        raise StateError("invalid worktree observations")
    for raw in worktrees:
        item = exact_fields(
            raw, {"id", "repository_ref", "status", "prunable", "locked"}, state=True
        )
        validate_ref(item["id"], "worktree")
        validate_ref(item["repository_ref"], "repository")
        worktree_status = bounded_string(item["status"], maximum=32, state=True)
        if worktree_status not in FIXTURE_WORKTREE_STATUSES:
            raise StateError("invalid worktree state")
        strict_bool(item["prunable"], state=True)
        strict_bool(item["locked"], state=True)
    require_sorted_unique(worktrees, "id")
    repository_statuses = {item["id"]: item["status"] for item in repositories}
    for item in worktrees:
        if repository_statuses.get(item["repository_ref"]) != "OK":
            raise StateError("worktree has no healthy repository source")

    candidates = top["candidates"]
    if not isinstance(candidates, list):
        raise StateError("invalid candidates")
    for raw in candidates:
        item = exact_fields(raw, {"id", "kind", "reason_codes"}, state=True)
        bounded_string(item["id"], maximum=128, state=True)
        candidate_kind = bounded_string(item["kind"], maximum=32, state=True)
        if candidate_kind not in CANDIDATE_KINDS or not isinstance(item["reason_codes"], list):
            raise StateError("invalid candidate")
        if not item["reason_codes"]:
            raise StateError("empty candidate")
        validated_reasons = []
        for reason in item["reason_codes"]:
            reason_value = bounded_string(reason, maximum=64, state=True)
            if reason_value not in CANDIDATE_REASONS:
                raise StateError("invalid candidate reason")
            validated_reasons.append(reason_value)
        if validated_reasons != sorted(set(validated_reasons)):
            raise StateError("noncanonical candidate reasons")
    require_sorted_unique(candidates, "id")
    if candidates != expected_candidates_from_observations(observations):
        raise StateError("candidate set does not match observations")
    stored_fingerprint = bounded_string(top["fingerprint"], maximum=64, state=True)
    if not HEX_64_RE.fullmatch(stored_fingerprint):
        raise StateError("invalid fingerprint")
    if stored_fingerprint != fingerprint(observations, candidates):
        raise StateError("fingerprint mismatch")
    return top


def load_state(path: Path) -> dict[str, Any] | None:
    try:
        path.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise StateError("cannot inspect state") from exc
    raw = read_bounded_regular(path, MAX_STATE_BYTES, state=True)
    return validate_state(parse_json_bytes(raw, state=True))


def require_private_parent(path: Path) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        try:
            path.mkdir(mode=0o700, parents=True, exist_ok=False)
            path.chmod(0o700)
            info = path.lstat()
        except (FileExistsError, OSError) as exc:
            raise StateWriteNotVerified("cannot create state parent") from exc
    except OSError as exc:
        raise StateWriteNotVerified("cannot inspect state parent") from exc
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISDIR(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) & 0o077
    ):
        raise StateWriteNotVerified("unsafe state parent")


def encode_state(value: dict[str, Any]) -> bytes:
    validate_state(value)
    encoded = (
        json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True) + "\n"
    ).encode("ascii")
    if len(encoded) > MAX_STATE_BYTES:
        raise StateWriteNotVerified("state exceeds size bound")
    return encoded


def write_state_atomic(path: Path, value: dict[str, Any], fail_stage: str | None) -> None:
    encoded = encode_state(value)
    require_private_parent(path.parent)
    try:
        existing = path.lstat()
    except FileNotFoundError:
        existing = None
    except OSError as exc:
        raise StateWriteNotVerified("cannot inspect state target") from exc
    if existing is not None and (
        stat.S_ISLNK(existing.st_mode)
        or not stat.S_ISREG(existing.st_mode)
        or existing.st_uid != os.geteuid()
        or stat.S_IMODE(existing.st_mode) != 0o600
    ):
        raise StateWriteNotVerified("unsafe state target")

    descriptor = -1
    temporary: str | None = None
    replaced = False
    try:
        descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        os.fchmod(descriptor, 0o600)
        view = memoryview(encoded)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise OSError("short write")
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        if fail_stage == "before-replace":
            raise StateWriteNotVerified("injected pre-replace failure")
        os.replace(temporary, path)
        temporary = None
        replaced = True
        if fail_stage == "after-replace":
            raise StateWriteNotVerified("injected post-replace failure")
        directory = os.open(
            path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0)
        )
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        current = path.lstat()
        if (
            not stat.S_ISREG(current.st_mode)
            or current.st_uid != os.geteuid()
            or stat.S_IMODE(current.st_mode) != 0o600
        ):
            raise StateWriteNotVerified("post-write state validation failed")
    except StateWriteNotVerified:
        raise
    except OSError as exc:
        raise StateWriteNotVerified(
            "state write outcome unknown" if replaced else "state write failed"
        ) from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
            except OSError:
                pass


def build_event(old: dict[str, Any], new: dict[str, Any]) -> dict[str, Any]:
    old_by_id = {item["id"]: item for item in old["candidates"]}
    new_by_id = {item["id"]: item for item in new["candidates"]}
    added = [new_by_id[key] for key in sorted(new_by_id.keys() - old_by_id.keys())]
    removed = [old_by_id[key] for key in sorted(old_by_id.keys() - new_by_id.keys())]
    changed = []
    for key in sorted(old_by_id.keys() & new_by_id.keys()):
        old_item = old_by_id[key]
        new_item = new_by_id[key]
        if old_item != new_item:
            changed.append(
                {
                    "id": key,
                    "old_reason_codes": old_item["reason_codes"],
                    "new_reason_codes": new_item["reason_codes"],
                }
            )

    old_health = {
        item["id"]: item["band"] for item in old["observations"]["filesystems"]
    }
    new_health = {
        item["id"]: item["band"] for item in new["observations"]["filesystems"]
    }
    health_transitions = []
    for key in sorted(old_health.keys() | new_health.keys()):
        old_band = old_health.get(key, "ABSENT")
        new_band = new_health.get(key, "ABSENT")
        if old_band != new_band:
            health_transitions.append({"id": key, "old": old_band, "new": new_band})
    return {
        "event_version": EVENT_VERSION,
        "event_type": "MAINTENANCE_CHANGE",
        "collector_instance_id": old["collector_instance_id"],
        "old_generation": old["generation"],
        "new_generation": new["generation"],
        "old_fingerprint": old["fingerprint"],
        "new_fingerprint": new["fingerprint"],
        "changes": {"added": added, "removed": removed, "changed": changed},
        "health_transitions": health_transitions,
    }


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Hourly-capable read-only inventory. A candidate never authorizes cleanup; it "
            "requests inspection. The first run records a silent baseline; later output occurs "
            "only for candidate or filesystem threshold-band changes."
        )
    )
    parser.add_argument("--state", help="private host-local snapshot path")
    parser.add_argument("--fixture", help="strict injected input; never queries live sources")
    parser.add_argument("--profile", default="default", help="Agent Deck profile")
    parser.add_argument("--agent-deck", default="agent-deck", help="Agent Deck executable")
    parser.add_argument("--git", default="git", help="git executable")
    parser.add_argument("--repo", action="append", default=[], help="configured repository root")
    parser.add_argument(
        "--filesystem",
        action="append",
        default=None,
        help="filesystem path to band (default: /)",
    )
    parser.add_argument("--warn-percent", type=int, default=80)
    parser.add_argument("--critical-percent", type=int, default=90)
    parser.add_argument(
        "--test-fail-write",
        choices=("before-replace", "after-replace"),
        help=argparse.SUPPRESS,
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        if (
            not PROFILE_RE.fullmatch(args.profile)
            or isinstance(args.warn_percent, bool)
            or isinstance(args.critical_percent, bool)
            or not 0 <= args.warn_percent < args.critical_percent <= 100
        ):
            raise InputError("invalid CLI configuration")
        state_path = absolute_path(args.state)
        filesystems = args.filesystem if args.filesystem is not None else ["/"]
        if not filesystems:
            raise InputError("at least one filesystem is required")
        if args.test_fail_write and not args.fixture:
            raise InputError("test write injection requires a fixture")
        if args.fixture:
            if args.repo or args.filesystem is not None:
                raise InputError("fixture mode cannot query live sources")
            collected = load_fixture(absolute_path(args.fixture))
        else:
            repositories = [normalized_path(item) for item in args.repo]
            normalized_filesystems = [normalized_path(item) for item in filesystems]
            if len(repositories) != len(set(repositories)) or len(normalized_filesystems) != len(
                set(normalized_filesystems)
            ):
                raise InputError("duplicate configured path")
            collected = collect_live(
                agent_deck=args.agent_deck,
                profile=args.profile,
                git=args.git,
                repositories=repositories,
                filesystems=normalized_filesystems,
            )
        observations, candidates, degraded = normalize_observation(
            collected, args.warn_percent, args.critical_percent
        )
    except InputError:
        sys.stderr.write("ERROR: INVALID_INPUT\n")
        return EXIT_INVALID_INPUT
    except StateError:
        sys.stderr.write("ERROR: INVALID_STATE\n")
        return EXIT_STATE_ERROR

    try:
        prior = load_state(state_path)
    except StateError:
        sys.stderr.write("ERROR: INVALID_STATE\n")
        return EXIT_STATE_ERROR

    current_fingerprint = fingerprint(observations, candidates)
    changed = prior is not None and prior["fingerprint"] != current_fingerprint
    try:
        if prior is None:
            collector_instance_id = new_instance_id()
            generation = 0
        else:
            collector_instance_id = prior["collector_instance_id"]
            generation = prior["generation"]
            if changed:
                if generation == MAX_GENERATION:
                    raise StateError("collector generation exhausted")
                generation += 1
        candidate_state = new_state(
            observations,
            candidates,
            collector_instance_id=collector_instance_id,
            generation=generation,
        )
        validate_state(candidate_state)
    except StateError:
        sys.stderr.write("ERROR: INVALID_STATE\n")
        return EXIT_STATE_ERROR

    try:
        if prior != candidate_state:
            write_state_atomic(state_path, candidate_state, args.test_fail_write)
    except (StateWriteNotVerified, StateError):
        sys.stderr.write("ERROR: STATE_WRITE_NOT_VERIFIED\n")
        return EXIT_STATE_ERROR

    if changed:
        event = build_event(prior, candidate_state)
        sys.stdout.write(
            json.dumps(event, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
            + "\n"
        )
    if degraded:
        sys.stderr.write("STATUS: COLLECTION_DEGRADED\n")
    if changed:
        return EXIT_CHANGED_DEGRADED if degraded else EXIT_CHANGED
    return EXIT_DEGRADED if degraded else EXIT_SILENT


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
