#!/usr/bin/env python3
"""Small, host-local owner/status/deadline registry for Agent Deck work."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import json
import math
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
from typing import Any, Iterator


FORMAT_VERSION = 1
MAX_STATE_BYTES = 1_048_576
WORK_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
# Agent Deck GenerateID is an 8-character random hex prefix plus Unix seconds.
# The wider bounds retain timestamp fallback IDs while rejecting editable titles.
SESSION_ID_RE = re.compile(r"^[0-9a-f]{8,20}-[0-9]{9,20}$")
RFC3339_RE = re.compile(
    r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    r"(?:\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
)

RECORD_FIELDS = {
    "work_id",
    "owner_session_id",
    "requested_status",
    "observed_status",
    "observed_substate",
    "deadline",
    "last_checked_at",
    "reason_code",
}
REQUESTED_ACTIVE = {"ACTIVE"}
TERMINAL_STATUSES = {
    "COMPLETE",
    "COMPLETE_WITH_BACKLOG",
    "NEEDS_USER",
    "NEEDS_SCOPE",
    "NEEDS_FLEET",
    "FAILED",
    "CANCELLED",
}
REQUESTED_STATUSES = REQUESTED_ACTIVE | TERMINAL_STATUSES
OBSERVED_STATUSES = {"NOT_CHECKED", "ACTIVE", "WAITING", "FAILED", "CANCELLED", "UNKNOWN"}
OBSERVED_SUBSTATES = {
    "NONE",
    "RUNNING",
    "IDLE_AT_EMPTY_PROMPT",
    "MODEL_UNAVAILABLE",
    "AUTH_401",
    "USAGE_LIMIT",
    "UNKNOWN",
}
SUBSTATE_MAP = {
    "": "NONE",
    "running": "RUNNING",
    "idle-at-empty-prompt": "IDLE_AT_EMPTY_PROMPT",
    "model-unavailable": "MODEL_UNAVAILABLE",
    "auth-401": "AUTH_401",
    "usage-limit": "USAGE_LIMIT",
}
STATUS_MAP = {
    "running": ("ACTIVE", "SESSION_RUNNING"),
    "queued": ("ACTIVE", "SESSION_QUEUED"),
    "waiting": ("WAITING", "SESSION_WAITING"),
    "idle": ("WAITING", "SESSION_IDLE"),
    "error": ("FAILED", "SESSION_ERROR"),
    "stopped": ("CANCELLED", "SESSION_STOPPED"),
}
POLL_REASONS = {
    "SESSION_RUNNING",
    "SESSION_QUEUED",
    "SESSION_WAITING",
    "SESSION_IDLE",
    "SESSION_ERROR",
    "SESSION_STOPPED",
    "SESSION_NOT_FOUND",
    "SESSION_ID_MISMATCH",
    "POLL_COMMAND_FAILED",
    "POLL_EXECUTABLE_MISSING",
    "POLL_TIMEOUT",
    "POLL_MALFORMED_JSON",
    "POLL_UNKNOWN_STATUS",
    "POLL_UNKNOWN_SUBSTATE",
}
TERMINAL_REASON_BY_STATUS = {
    "COMPLETE": {"CONDUCTOR_VERIFIED"},
    "COMPLETE_WITH_BACKLOG": {"CONDUCTOR_VERIFIED"},
    "NEEDS_USER": {"USER_DECISION_REQUIRED"},
    "NEEDS_SCOPE": {"SCOPE_STOP"},
    "NEEDS_FLEET": {"FLEET_STOP"},
    "FAILED": {"ACCEPTANCE_FAILED"},
    "CANCELLED": {"CANCELLED_BY_USER"},
}
REASON_CODES = {"REGISTERED", "REGISTRATION_UPDATED"} | POLL_REASONS
for _terminal_reasons in TERMINAL_REASON_BY_STATUS.values():
    REASON_CODES.update(_terminal_reasons)
TERMINAL_REASONS = set().union(*TERMINAL_REASON_BY_STATUS.values())


class RegistryError(Exception):
    """A sanitized, user-visible registry failure."""


class DuplicateKeyError(ValueError):
    """Raised when parsed JSON contains a duplicate object key."""


def no_duplicate_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateKeyError("duplicate JSON key")
        result[key] = value
    return result


def parse_json_document(raw: str) -> Any:
    return json.loads(raw, object_pairs_hook=no_duplicate_object)


def parse_rfc3339(value: str, label: str) -> datetime:
    if (
        not isinstance(value, str)
        or not value
        or len(value) > 64
        or RFC3339_RE.fullmatch(value) is None
    ):
        raise RegistryError(f"invalid {label}")
    rendered = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        parsed = datetime.fromisoformat(rendered)
        if parsed.tzinfo is None or parsed.utcoffset() is None:
            raise ValueError("timezone required")
        return parsed.astimezone(timezone.utc)
    except (ValueError, OverflowError, OSError) as exc:
        raise RegistryError(f"invalid {label}") from exc


def canonical_rfc3339(value: str, label: str) -> str:
    parsed = parse_rfc3339(value, label)
    rendered = (
        f"{parsed.year:04d}-{parsed.month:02d}-{parsed.day:02d}T"
        f"{parsed.hour:02d}:{parsed.minute:02d}:{parsed.second:02d}"
    )
    if parsed.microsecond:
        rendered += "." + f"{parsed.microsecond:06d}".rstrip("0")
    return rendered + "Z"


def current_time(value: str | None) -> tuple[datetime, str]:
    if value is None:
        parsed = datetime.now(timezone.utc).replace(microsecond=0)
        return parsed, parsed.isoformat().replace("+00:00", "Z")
    rendered = canonical_rfc3339(value, "clock")
    return parse_rfc3339(rendered, "clock"), rendered


def validate_work_id(value: Any) -> str:
    if not isinstance(value, str) or not WORK_ID_RE.fullmatch(value):
        raise RegistryError("invalid work ID")
    return value


def validate_session_id(value: Any) -> str:
    if not isinstance(value, str) or not SESSION_ID_RE.fullmatch(value):
        raise RegistryError("invalid immutable owner session ID")
    return value


def validate_profile(value: str | None) -> str | None:
    if value is None:
        return None
    if not WORK_ID_RE.fullmatch(value):
        raise RegistryError("invalid profile")
    return value


def default_state_path() -> Path:
    base = os.environ.get("XDG_STATE_HOME")
    state_home = Path(base) if base else Path.home() / ".local" / "state"
    return state_home / "agent-deck" / "work-registry.json"


def absolute_path(value: str | None) -> Path:
    path = Path(value) if value else default_state_path()
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.absolute()


def require_private_directory(path: Path, *, create: bool) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        if not create:
            raise RegistryError("state parent is missing")
        try:
            path.mkdir(mode=0o700, parents=True, exist_ok=False)
            path.chmod(0o700)
            info = path.lstat()
        except (FileExistsError, OSError) as exc:
            raise RegistryError("cannot create private state parent") from exc
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        raise RegistryError("state parent type is unsafe")
    if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise RegistryError("state parent permissions are unsafe")


def require_private_regular(path: Path) -> os.stat_result | None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise RegistryError("state file type is unsafe")
    if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise RegistryError("state file permissions are unsafe")
    return info


@contextmanager
def registry_lock(state_path: Path) -> Iterator[None]:
    require_private_directory(state_path.parent, create=True)
    lock_path = state_path.with_name(state_path.name + ".lock")
    existing = require_private_regular(lock_path)
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except OSError as exc:
        raise RegistryError("cannot open registry lock") from exc
    try:
        current = os.fstat(descriptor)
        if not stat.S_ISREG(current.st_mode) or current.st_uid != os.geteuid():
            raise RegistryError("registry lock type is unsafe")
        if stat.S_IMODE(current.st_mode) != 0o600:
            raise RegistryError("registry lock permissions are unsafe")
        if existing is not None and (existing.st_dev, existing.st_ino) != (current.st_dev, current.st_ino):
            raise RegistryError("registry lock changed during open")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RegistryError("registry is busy; single writer lock not acquired") from exc
        yield
    finally:
        os.close(descriptor)


def empty_state() -> dict[str, Any]:
    return {"format_version": FORMAT_VERSION, "records": {}}


def read_private_file(path: Path, expected: os.stat_result) -> bytes:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise RegistryError("cannot read registry") from exc
    try:
        current = os.fstat(descriptor)
        if (expected.st_dev, expected.st_ino) != (current.st_dev, current.st_ino):
            raise RegistryError("registry changed during open")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, 65_536)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_STATE_BYTES:
                raise RegistryError("registry exceeds size limit")
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def validate_record(key: str, value: Any) -> dict[str, Any]:
    validate_work_id(key)
    if not isinstance(value, dict) or set(value) != RECORD_FIELDS:
        raise RegistryError("registry record has an invalid shape")
    if value["work_id"] != key:
        raise RegistryError("registry record key mismatch")
    validate_work_id(value["work_id"])
    validate_session_id(value["owner_session_id"])
    requested_status = value["requested_status"]
    if not isinstance(requested_status, str) or requested_status not in REQUESTED_STATUSES:
        raise RegistryError("registry record has an invalid requested status")
    observed_status = value["observed_status"]
    if not isinstance(observed_status, str) or observed_status not in OBSERVED_STATUSES:
        raise RegistryError("registry record has an invalid observed status")
    observed_substate = value["observed_substate"]
    if not isinstance(observed_substate, str) or observed_substate not in OBSERVED_SUBSTATES:
        raise RegistryError("registry record has an invalid observed substate")
    canonical_rfc3339(value["deadline"], "deadline")
    if value["last_checked_at"] is not None:
        canonical_rfc3339(value["last_checked_at"], "last checked timestamp")
    reason_code = value["reason_code"]
    if not isinstance(reason_code, str) or reason_code not in REASON_CODES:
        raise RegistryError("registry record has an invalid reason code")
    if requested_status in TERMINAL_STATUSES:
        if reason_code not in TERMINAL_REASON_BY_STATUS[requested_status]:
            raise RegistryError("registry terminal status and reason disagree")
    elif reason_code in TERMINAL_REASONS:
        raise RegistryError("registry active status has a terminal reason")
    return value


def validate_state(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != {"format_version", "records"}:
        raise RegistryError("registry has an invalid shape")
    version = value["format_version"]
    if isinstance(version, bool) or not isinstance(version, int) or version != FORMAT_VERSION:
        raise RegistryError("registry format version is unsupported")
    records = value["records"]
    if not isinstance(records, dict) or len(records) > 10_000:
        raise RegistryError("registry records are invalid")
    for key, record in records.items():
        validate_record(key, record)
    return value


def load_state(path: Path) -> dict[str, Any]:
    existing = require_private_regular(path)
    if existing is None:
        return empty_state()
    raw = read_private_file(path, existing)
    try:
        text = raw.decode("utf-8")
        parsed = parse_json_document(text)
    except (UnicodeDecodeError, json.JSONDecodeError, DuplicateKeyError) as exc:
        raise RegistryError("registry JSON is malformed") from exc
    return validate_state(parsed)


def encode_state(state: dict[str, Any]) -> bytes:
    validate_state(state)
    return (json.dumps(state, indent=2, sort_keys=True, ensure_ascii=True) + "\n").encode("utf-8")


def atomic_write(path: Path, state: dict[str, Any]) -> None:
    require_private_directory(path.parent, create=False)
    require_private_regular(path)
    payload = encode_state(state)
    if len(payload) > MAX_STATE_BYTES:
        raise RegistryError("registry exceeds size limit")
    descriptor = -1
    temporary: str | None = None
    try:
        descriptor, temporary = tempfile.mkstemp(
            prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
        )
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            descriptor = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        temporary = None
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError as exc:
        raise RegistryError("atomic registry write failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def projection(record: dict[str, Any], now: datetime) -> dict[str, Any]:
    result = dict(record)
    deadline = parse_rfc3339(record["deadline"], "deadline")
    result["overdue"] = record["requested_status"] not in TERMINAL_STATUSES and now > deadline
    return result


def emit(value: Any) -> None:
    sys.stdout.write(json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True) + "\n")


def unknown_observation(record: dict[str, Any], reason: str, checked_at: str) -> None:
    record["observed_status"] = "UNKNOWN"
    record["observed_substate"] = "UNKNOWN"
    record["last_checked_at"] = checked_at
    record["reason_code"] = reason


def poll_record(
    record: dict[str, Any],
    *,
    executable: str,
    profile: str | None,
    timeout: float,
    checked_at: str,
) -> bool:
    command = [executable]
    if profile is not None:
        command.extend(["-p", profile])
    command.extend(["session", "show", record["owner_session_id"], "--json"])
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        unknown_observation(record, "POLL_TIMEOUT", checked_at)
        return False
    except UnicodeDecodeError:
        unknown_observation(record, "POLL_MALFORMED_JSON", checked_at)
        return False
    except (FileNotFoundError, PermissionError, OSError):
        unknown_observation(record, "POLL_EXECUTABLE_MISSING", checked_at)
        return False
    if result.returncode != 0:
        reason = "SESSION_NOT_FOUND" if result.returncode == 2 else "POLL_COMMAND_FAILED"
        unknown_observation(record, reason, checked_at)
        return False
    try:
        payload = parse_json_document(result.stdout)
    except (json.JSONDecodeError, DuplicateKeyError):
        unknown_observation(record, "POLL_MALFORMED_JSON", checked_at)
        return False
    if not isinstance(payload, dict):
        unknown_observation(record, "POLL_MALFORMED_JSON", checked_at)
        return False
    if payload.get("id") != record["owner_session_id"]:
        unknown_observation(record, "SESSION_ID_MISMATCH", checked_at)
        return False
    raw_status = payload.get("status")
    if not isinstance(raw_status, str) or raw_status not in STATUS_MAP:
        unknown_observation(record, "POLL_UNKNOWN_STATUS", checked_at)
        return False
    raw_substate = payload.get("substate", "")
    if not isinstance(raw_substate, str) or raw_substate not in SUBSTATE_MAP:
        unknown_observation(record, "POLL_UNKNOWN_SUBSTATE", checked_at)
        return False
    observed, reason = STATUS_MAP[raw_status]
    record["observed_status"] = observed
    record["observed_substate"] = SUBSTATE_MAP[raw_substate]
    record["last_checked_at"] = checked_at
    record["reason_code"] = reason
    return True


def command_register(
    args: argparse.Namespace, state: dict[str, Any], now: datetime
) -> tuple[bool, Any]:
    work_id = validate_work_id(args.work_id)
    owner = validate_session_id(args.owner_session_id)
    deadline = canonical_rfc3339(args.deadline, "deadline")
    records = state["records"]
    existing = records.get(work_id)
    if existing is None:
        records[work_id] = {
            "work_id": work_id,
            "owner_session_id": owner,
            "requested_status": "ACTIVE",
            "observed_status": "NOT_CHECKED",
            "observed_substate": "NONE",
            "deadline": deadline,
            "last_checked_at": None,
            "reason_code": "REGISTERED",
        }
    else:
        if existing["owner_session_id"] != owner:
            raise RegistryError("registered owner session ID is immutable")
        if existing["requested_status"] in TERMINAL_STATUSES:
            raise RegistryError("terminal work cannot be re-registered")
        existing["deadline"] = deadline
        existing["reason_code"] = "REGISTRATION_UPDATED"
    return True, projection(records[work_id], now)


def command_show(
    args: argparse.Namespace, state: dict[str, Any], now: datetime
) -> tuple[bool, Any]:
    work_id = validate_work_id(args.work_id)
    record = state["records"].get(work_id)
    if record is None:
        raise RegistryError("work ID is not registered")
    return False, projection(record, now)


def command_list(
    _args: argparse.Namespace, state: dict[str, Any], now: datetime
) -> tuple[bool, Any]:
    rows = [projection(state["records"][key], now) for key in sorted(state["records"])]
    return False, {"format_version": FORMAT_VERSION, "records": rows}


def command_mark_terminal(
    args: argparse.Namespace, state: dict[str, Any], now: datetime
) -> tuple[bool, Any]:
    work_id = validate_work_id(args.work_id)
    record = state["records"].get(work_id)
    if record is None:
        raise RegistryError("work ID is not registered")
    status_value = args.status
    reason = args.reason
    if status_value not in TERMINAL_STATUSES:
        raise RegistryError("invalid terminal status")
    if reason not in TERMINAL_REASON_BY_STATUS[status_value]:
        raise RegistryError("terminal reason is invalid for status")
    if record["requested_status"] in TERMINAL_STATUSES and record["requested_status"] != status_value:
        raise RegistryError("terminal status is immutable")
    record["requested_status"] = status_value
    record["reason_code"] = reason
    return True, projection(record, now)


def command_reconcile(
    args: argparse.Namespace,
    state: dict[str, Any],
    now: datetime,
    checked_at: str,
) -> tuple[bool, bool, Any]:
    if args.all:
        target_ids = [
            key
            for key in sorted(state["records"])
            if state["records"][key]["requested_status"] not in TERMINAL_STATUSES
        ]
    else:
        if args.work_id is None:
            raise RegistryError("reconcile requires one work ID or --all")
        work_id = validate_work_id(args.work_id)
        if work_id not in state["records"]:
            raise RegistryError("work ID is not registered")
        target_ids = (
            []
            if state["records"][work_id]["requested_status"] in TERMINAL_STATUSES
            else [work_id]
        )

    verified = True
    for work_id in target_ids:
        if not poll_record(
            state["records"][work_id],
            executable=args.agent_deck,
            profile=args.profile,
            timeout=args.timeout,
            checked_at=checked_at,
        ):
            verified = False

    if args.all:
        result = {
            "format_version": FORMAT_VERSION,
            "records": [projection(state["records"][key], now) for key in target_ids],
        }
    else:
        result = projection(state["records"][args.work_id], now)
    return bool(target_ids), verified, result


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Host-local single writer work registry. It polls immutable Agent Deck session IDs; "
            "it does not prove work completion. Concurrent or cross-host ownership is unsupported."
        )
    )
    parser.add_argument("--state", help="registry path (default: private XDG local-state path)")
    parser.add_argument("--agent-deck", default="agent-deck", help="Agent Deck executable")
    parser.add_argument("--profile", help="optional Agent Deck profile")
    parser.add_argument("--timeout", type=float, default=30.0, help="poll timeout in seconds")
    parser.add_argument("--now", help="inject RFC3339 clock for deterministic checks")
    subparsers = parser.add_subparsers(dest="command", required=True)

    register = subparsers.add_parser("register", help="register or update one nonterminal work item")
    register.add_argument("work_id")
    register.add_argument("--owner-session-id", required=True)
    register.add_argument("--deadline", required=True)

    reconcile = subparsers.add_parser("reconcile", help="poll one or all nonterminal work items")
    targets = reconcile.add_mutually_exclusive_group()
    targets.add_argument("work_id", nargs="?")
    targets.add_argument("--all", action="store_true")

    show = subparsers.add_parser("show", help="show one sanitized record")
    show.add_argument("work_id")
    subparsers.add_parser("list", help="list sanitized records")

    terminal = subparsers.add_parser(
        "mark-terminal", help="record an explicit conductor-verified terminal disposition"
    )
    terminal.add_argument("work_id")
    terminal.add_argument("--status", required=True)
    terminal.add_argument("--reason", required=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not math.isfinite(args.timeout) or args.timeout <= 0 or args.timeout > 300:
        sys.stderr.write("ERROR: invalid poll timeout\n")
        return 2
    try:
        args.profile = validate_profile(args.profile)
        state_path = absolute_path(args.state)
        now, checked_at = current_time(args.now)
        should_write = False
        verified = True
        with registry_lock(state_path):
            state = load_state(state_path)
            if args.command == "register":
                should_write, output = command_register(args, state, now)
            elif args.command == "show":
                should_write, output = command_show(args, state, now)
            elif args.command == "list":
                should_write, output = command_list(args, state, now)
            elif args.command == "mark-terminal":
                should_write, output = command_mark_terminal(args, state, now)
            elif args.command == "reconcile":
                should_write, verified, output = command_reconcile(args, state, now, checked_at)
            else:
                raise RegistryError("unknown command")
            if should_write:
                atomic_write(state_path, state)
            emit(output)
        return 0 if verified else 4
    except RegistryError as exc:
        sys.stderr.write(f"ERROR: {exc}\n")
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
